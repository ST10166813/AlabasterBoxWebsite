@{
    ViewData["Title"] = "Donate";
}

@section Styles {
    <style>
        /* RESET */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --glass-1: rgba(18,18,22,.55);
            --glass-2: rgba(18,18,22,.35);
            --glass-brd: rgba(255,255,255,.14);
            --gold: #FFD700;
        }

       /* 1. Make sure the background isn't being blocked by a solid color */
        html, body {
            font-family: 'Poppins', 'Segoe UI', sans-serif;
            color: #fff;
            min-height: 100vh;
            background-color: transparent !important; /* Changed from #000 */
        }

        /* 2. Attach the specific Donate background to the wrapper instead of the body */
        .page-wrapper::before {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -1; /* This puts it exactly between the layout and your text */
            pointer-events: none;
            background-image: url('@Url.Content("~/images/4.jpg")');
            background-position: center;
            background-size: cover;
            background-repeat: no-repeat;
            background-attachment: fixed;
            filter: saturate(1.05) brightness(0.7); /* Slightly darker for better text contrast */
        }
            /* subtle overlay for contrast */
            body::after {
                content: "";
                position: fixed;
                inset: 0;
                z-index: -1;
                background: rgba(0,0,0,0.14);
                pointer-events: none;
            }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* PAGE HEAD */
        .page-head {
            max-width: 1100px;
            margin: 48px auto 24px;
            padding: 0 16px;
            position: relative;
            z-index: 1;
            text-align: center;
        }

            .page-head h1 {
                font-size: clamp(2.2rem, 5vw, 3rem);
                font-weight: 900;
                text-transform: uppercase;
                color: #fff;
                text-shadow: 0 2px 6px rgba(0,0,0,.55);
                letter-spacing: .3px;
                margin-bottom: .25rem;
            }

            .page-head .tagline {
                font-size: 1.1rem;
                color: #f0f0f0;
                opacity: .95;
                text-shadow: 0 1px 3px rgba(0,0,0,.45);
                letter-spacing: .6px;
            }

        /* DONATE CARD */
        .donate-section {
            display: flex;
            justify-content: center;
            padding: 1rem 1.2rem 4rem;
            z-index: 1;
            position: relative;
        }

        .donate-card {
            width: 100%;
            max-width: 1200px;
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 2rem;
            background: var(--glass-1);
            border-radius: 1.25rem;
            padding: 2rem;
            border: 1px solid var(--glass-brd);
            backdrop-filter: blur(18px) saturate(160%);
            box-shadow: 0 26px 60px rgba(0,0,0,0.55);
            transform: translateY(12px);
            opacity: 0;
            transition: all 700ms cubic-bezier(.16,.84,.28,1);
        }

            .donate-card.visible {
                transform: translateY(0);
                opacity: 1;
            }

        /* left */
        .donate-content h2 {
            font-size: 2.1rem;
            font-weight: 900;
            margin-bottom: 0.8rem;
            color: #fff;
        }

        .donate-content p {
            font-size: 1.02rem;
            color: #f1f1f1;
            line-height: 1.7;
            margin-bottom: 1rem;
        }

        .donate-note {
            font-size: 0.98rem;
            color: #fff;
            background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
            padding: 0.9rem;
            border-radius: 0.8rem;
            border: 1px solid rgba(255,215,0,0.06);
            box-shadow: 0 8px 20px rgba(0,0,0,0.35);
        }

        /* right column */
        .donate-options {
            display: flex;
            flex-direction: column;
            gap: 1.1rem;
        }

        .option-card {
            background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
            border-radius: 1rem;
            padding: 1.15rem;
            border: 1px solid rgba(255,215,0,0.08);
            box-shadow: 0 12px 30px rgba(0,0,0,0.45);
        }

            .option-card h3 {
                font-size: 1.15rem;
                font-weight: 800;
                margin-bottom: 0.6rem;
                color: var(--gold);
            }

            .option-card p {
                font-size: 0.98rem;
                color: #eee;
                line-height: 1.6;
                margin-bottom: 0.7rem;
            }

        .bank-details, .address-block {
            background: rgba(0,0,0,0.35);
            border-radius: 0.75rem;
            padding: 0.9rem;
            color: #fff;
            border: 1px dashed rgba(255,215,0,0.12);
            font-size: 0.98rem;
        }

        .bank-line {
            display: flex;
            justify-content: space-between;
            gap: .8rem;
            margin-bottom: .5rem;
            align-items: center;
        }

            .bank-line strong {
                color: #ffd;
                font-weight: 700;
            }

        .copy-btn {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            padding: 6px 10px;
            font-size: .9rem;
            border-radius: 999px;
            background: rgba(255,215,0,0.95);
            color: #000;
            border: none;
            cursor: pointer;
            font-weight: 700;
            box-shadow: 0 8px 20px rgba(255,215,0,0.12);
        }

        .small-muted {
            font-size: .88rem;
            color: #ddd;
            opacity: .95;
        }

        .btn-secondary {
            display: inline-block;
            margin-top: .6rem;
            padding: 10px 16px;
            border-radius: 999px;
            background: linear-gradient(135deg, rgba(255,215,0,0.08), rgba(255,215,0,0.12));
            color: var(--gold);
            border: 1px solid rgba(255,215,0,0.12);
            font-weight: 800;
            font-size: .95rem;
        }

        /* responsive */
        @@media (max-width: 992px) {
            .donate-card {
                grid-template-columns: 1fr;
                padding: 1.4rem;
                gap: 1rem;
            }
        }

        @@media (max-width: 640px) {
            .page-head h1 {
                font-size: 2rem;
            }

            .donate-content h2 {
                font-size: 1.6rem;
            }

            .copy-btn {
                padding: 6px 8px;
                font-size: .85rem;
            }
        }
    </style>
}

<!-- PAGE HEADING -->
<div class="page-head">
    <h1>Donate</h1>
    <div class="tagline">Give • Support • Impact</div>
</div>

<section class="donate-section" aria-labelledby="donate_heading">
    <div class="donate-card" id="donate_card">
        <!-- LEFT: Story / Mission -->
        <div class="donate-content">
            <h2 id="donate_heading">Your gift changes lives</h2>

            @* show any messages that the server may set (keeps prior keys for compatibility) *@
            @if (TempData["PayfastError"] != null || TempData["Error"] != null)
            {
                <div style="background:#7a1b1b;padding:10px;border-radius:6px;margin-bottom:12px;color:#fff;">
                    @(TempData["PayfastError"] ?? TempData["Error"])
                </div>
            }
            @if (TempData["PayfastMessage"] != null || TempData["Message"] != null)
            {
                <div style="background:#1b5a1b;padding:10px;border-radius:6px;margin-bottom:12px;color:#fff;">
                    @(TempData["PayfastMessage"] ?? TempData["Message"])
                </div>
            }

            <p>Alabaster Box Anointing Ministries relies on faithful supporters to run feeding schemes, outreach, worship gatherings and practical assistance for those in need. Every gift — large or small — helps share hope and practical care in our community.</p>

            <div class="donate-note" style="margin-top:1rem;">
                <p class="small-muted">Need a receipt or have questions about giving? Visit our <a href="/AboutUs" style="color:#FFD700; font-weight:700;">About Us</a> page or <a href="/Home/Contact" style="color:#FFD700; font-weight:700;">Contact</a> us and our team will assist you.</p>
            </div>

            <div style="height:18px;"></div>

            <!-- SIMPLE CTA FOR CARD PAYMENTS (removed PayFast portal) -->
            <div class="option-card" aria-labelledby="card_cta_title" style="margin-top:0.8rem;">
                <h3 id="card_cta_title">Online card payments</h3>
                <p>We currently process online card payments manually. If you prefer to pay by card, please <a href="/Home/Contact" style="color:#FFD700; font-weight:800;">contact us</a> and we will provide a secure link or assist you directly.</p>
                <p class="small-muted">If you'd rather do an immediate transfer, use the bank details on the right — and let us know so we can issue a receipt.</p>
            </div>

            <div class="donation-footer" style="margin-top:1rem;">
                <p class="small-muted">Thank you for partnering with us — we pray every seed sown multiplies into blessing for those in need.</p>
            </div>
        </div>

        <!-- RIGHT: Donate Options -->
        <div class="donate-options" id="donate_options">
            <div class="option-card" aria-labelledby="monetary_title">
                <h3 id="monetary_title">Monetary Donations (EFT)</h3>
                <p>If you would like to donate via EFT, use the details below. After transfer, please contact us so we can issue a receipt and say thank you.</p>

                <div class="bank-details" role="region" aria-label="Banking details">
                    <div class="bank-line"><span><strong>Bank:</strong> First National Bank</span></div>

                    <div class="bank-line">
                        <span><strong>Account Name:</strong> The Alabaster Box Anointing Ministries</span>
                        <button class="copy-btn" data-copy="The Alabaster Box Anointing Ministries" title="Copy account name">Copy</button>
                    </div>

                    <div class="bank-line">
                        <span><strong>Account Number:</strong> 62787787880</span>
                        <button class="copy-btn" data-copy="62787787880" title="Copy account number">Copy</button>
                    </div>

                    <div class="bank-line">
                        <span><strong>Branch Code:</strong> 250655</span>
                        <button class="copy-btn" data-copy="250655" title="Copy branch code">Copy</button>
                    </div>

                    <div class="bank-line"><span><strong>Account Type:</strong> Cheque account</span></div>
                </div>

                <p class="small-muted" style="margin-top:0.7rem;">Tip: Click <em>Copy</em> to quickly paste details into your internet banking or payments app.</p>
            </div>

            <div class="option-card" aria-labelledby="items_title">
                <h3 id="items_title">Donations of Physical Items</h3>
                <p>If you'd like to send clothing, food, supplies or other goods, please contact us first to arrange drop-off times. Pack items securely and include a note with your contact details so we can acknowledge receipt.</p>

                <div class="address-block" role="region" aria-label="Postal address">
                    <div class="address-lines">
                        2 Garden Crescent<br />
                        New Germany<br />
                        Pinetown<br />
                        KwaZulu-Natal<br />
                        3601
                    </div>
                </div>

                <a class="btn-secondary" href="https://www.google.com/maps/search/2+Garden+Crescent+Pinetown+3601" target="_blank" rel="noopener noreferrer">Open in Maps</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // reveal donate card (animation)
        (function () {
            const donateObserver = new IntersectionObserver(entries => {
                entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('visible'); });
            }, { threshold: 0.12 });

            document.querySelectorAll('.donate-card').forEach(el => donateObserver.observe(el));
        })();

        // Copy helpers (bank details)
        (function () {
            function showCopyFeedback(btn) {
                const original = btn.textContent;
                btn.textContent = 'Copied!';
                btn.disabled = true;
                setTimeout(() => { btn.textContent = original; btn.disabled = false; }, 1600);
            }

            function handleCopy(text, btn) {
                if (!navigator.clipboard) {
                    const ta = document.createElement('textarea');
                    ta.value = text;
                    document.body.appendChild(ta);
                    ta.select();
                    try { document.execCommand('copy'); } catch (e) { console.error('Copy failed', e); }
                    ta.remove();
                    showCopyFeedback(btn);
                    return;
                }
                navigator.clipboard.writeText(text).then(() => showCopyFeedback(btn)).catch(err => {
                    console.error('Could not copy text: ', err);
                });
            }

            document.querySelectorAll('.copy-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    const text = btn.getAttribute('data-copy') || '';
                    handleCopy(text, btn);
                });
            });
        })();
    </script>
}
