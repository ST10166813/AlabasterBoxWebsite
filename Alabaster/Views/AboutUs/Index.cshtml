@{
    ViewData["Title"] = "About Us";
}

@section Styles {
    <style>
        /* ------------------ TOKENS: Bright Orange Theme ------------------ */
        :root {
            --glass-start: rgba(45, 20, 5, 0.6);
            --glass-end: rgba(30, 10, 0, 0.45);
            --glass-border: rgba(255, 215, 0, 0.3);
            --glass-shadow: 0 40px 90px rgba(0,0,0,.55);
            --gold: #FFD700;
            --ink: #fff;
        }

        /* ------------------ RESET ------------------ */
        * { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            font-family: 'Poppins', sans-serif;
            background: transparent; /* Handled by Layout */
            color: var(--ink);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ------------------ LAYOUT WRAPPER ------------------ */
        .about-wrap {
            position: relative;
            z-index: 1;
            display: grid;
            gap: 3rem;
            padding: 120px 1.25rem 80px; /* Space for fixed nav */
            max-width: 1100px; /* Constrained for better readability */
            margin-inline: auto;
        }

        .page-head { text-align: center; margin-bottom: 1rem; }
        .page-head h1 {
            font-size: clamp(2.4rem, 5vw, 4rem);
            font-weight: 900;
            text-transform: uppercase;
            text-shadow: 0 2px 10px rgba(0,0,0,0.5);
        }

        .hero {
            text-align: center;
            font-size: 1.15rem;
            line-height: 1.8;
            max-width: 800px;
            margin: 0 auto;
            opacity: 0.9;
        }

        /* ------------------ THE HERO CARD (FIXED) ------------------ */
        .panel {
            border-radius: 28px;
            border: 1px solid var(--glass-border);
            background: linear-gradient(180deg, var(--glass-start), var(--glass-end));
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            box-shadow: var(--glass-shadow);
        }

        .hero-card {
            display: flex; /* Switched to flex for better control */
            align-items: center;
            gap: 3rem;
            padding: 3rem;
            opacity: 0;
            transform: translateY(20px);
            transition: all .8s ease;
        }

        .hero-card.visible { opacity: 1; transform: translateY(0); }

        .hero-media {
            flex: 0 0 320px; /* Fixed width for the image */
        }

        .hero-media .primary {
            width: 320px;
            height: 320px; /* Forced Square */
            border-radius: 20px;
            object-fit: cover; /* CROPS WITHOUT STRETCHING */
            border: 2px solid var(--glass-border);
            box-shadow: 0 15px 35px rgba(0,0,0,0.4);
        }

        .hero-content { flex: 1; }
        .hero-content h2 {
            font-size: 2.2rem;
            color: var(--gold);
            font-weight: 800;
            margin-bottom: 1rem;
        }

        .hero-content p {
            line-height: 1.7;
            margin-bottom: 1rem;
        }

        /* ------------------ STATS ------------------ */
        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
        }

        .stat { padding: 1.5rem; text-align: center; }
        .value { font-size: 2.8rem; font-weight: 900; color: var(--gold); }
        .label { font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; }
        
        .progress {
            height: 4px;
            background: rgba(255,255,255,0.1);
            margin-top: 10px;
            border-radius: 10px;
        }
        .progress i { 
            display: block; height: 100%; background: var(--gold); width: 0; 
            transition: width 1.5s ease;
        }

        /* ------------------ CONTACT ------------------ */
        .contact-panel {
            padding: 2.5rem;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }

        .contact-block h3 { color: var(--gold); margin-bottom: 1rem; }
        .kv dt { color: var(--gold); font-weight: 700; font-size: 0.8rem; text-transform: uppercase; }
        .kv dd { margin-bottom: 0.5rem; }

        .social-row { display: flex; gap: 15px; margin-top: 15px; }
        .social-icon {
            width: 45px; height: 45px;
            background: rgba(255,255,255,0.1);
            border-radius: 50%;
            display: grid; place-items: center;
            transition: 0.3s;
        }
        .social-icon:hover { background: var(--gold); transform: translateY(-3px); }
        .social-icon img { width: 22px; height: 22px; }

        /* ------------------ RESPONSIVE ------------------ */
        @@media (max-width: 900px) {
            .hero-card { flex-direction: column; text-align: center; padding: 2rem; }
            .hero-media { flex: 0 0 auto; }
            .contact-panel { grid-template-columns: 1fr; }
            .stats { grid-template-columns: 1fr; }
        }
    </style>
}

<div class="about-wrap">
    <header class="page-head">
        <h1>About Us</h1>
        <div class="tagline">Christ-centred • Discipleship • Outreach • Prayer</div>
    </header>

    <section class="hero">
        <p>
            We exist to share the hope and healing power of Jesus Christ. From city streets to rural communities, we serve
            with compassion—feeding families, uplifting the brokenhearted, and equipping believers to walk boldly in their calling.
        </p>
    </section>

    <section class="panel hero-card">
        <div class="hero-media">
            <img class="primary" src="~/images/team.jpg" alt="Our Team">
        </div>

        <div class="hero-content">
            <h2>Who We Are</h2>
            <p>
                Rooted in <strong>Mark 16:15</strong>, our mission is to go into all the world and proclaim the Good News.
                We believe every person matters and that through faith, lives can be restored and empowered.
            </p>
            <p>
                Whether we’re feeding the hungry, praying for the brokenhearted, or equipping others with the Word,
                our purpose remains the same: serve with compassion and walk in the anointing of the Holy Spirit.
            </p>
        </div>
    </section>

    <section class="stats-wrap">
        <div class="stats">
            <div class="stat panel">
                <div class="value" data-target="6">0</div>
                <div class="label">Years Serving</div>
                <div class="progress"><i style="width: 60%"></i></div>
            </div>
            <div class="stat panel">
                <div class="value" data-target="58">0</div>
                <div class="label">Communities</div>
                <div class="progress"><i style="width: 75%"></i></div>
            </div>
            <div class="stat panel">
                <div class="value" data-target="2400">0</div>
                <div class="label">Meals Provided</div>
                <div class="progress"><i style="width: 90%"></i></div>
            </div>
        </div>
    </section>

    <section class="panel contact-panel">
        <div class="contact-block">
            <h3><i class="bi bi-geo-alt"></i> Locations</h3>
            <dl class="kv">
                <dt>Main Location</dt>
                <dd>2 Garden Crescent, New Germany, Pinetown, KZN, 3601</dd>
            </dl>
            <a href="https://maps.google.com" target="_blank" style="color:var(--gold)">View on Map</a>
        </div>

        <div class="contact-block">
            <h3><i class="bi bi-telephone"></i> Contact</h3>
            <dl class="kv">
                <dt>Phone / WhatsApp</dt>
                <dd>+27 62 572 5221</dd>
                <dt>Email</dt>
                <dd>alabasterbox28@gmail.com</dd>
            </dl>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        const reveal = (el) => {
            const io = new IntersectionObserver((entries) => {
                entries.forEach(e => {
                    if (e.isIntersecting) { e.target.classList.add('visible'); }
                });
            }, { threshold: 0.1 });
            io.observe(el);
        };

        function countUp(el){
            const target = +el.dataset.target;
            let count = 0;
            const speed = target / 50;
            const update = () => {
                count += speed;
                if(count < target) {
                    el.innerText = Math.floor(count);
                    setTimeout(update, 20);
                } else {
                    el.innerText = target;
                }
            };
            update();
        }

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.hero-card').forEach(reveal);
            document.querySelectorAll('.value').forEach(countUp);
        });
    </script>
}