@model IEnumerable<Alabaster.Models.GalleryImage>

@{
    ViewData["Title"] = "Gallery";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .gallery-container {
        padding-top: 120px; /* Space for the Nav Guard */
        max-width: 1200px;
        margin: 0 auto;
        padding-bottom: 80px;
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
        padding: 20px;
    }

    .gallery-item {
        position: relative;
        overflow: hidden;
        border-radius: 15px;
        border: 2px solid rgba(255, 215, 0, 0.3);
        background: #000;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
    }

    /* The Square Image Fix */
    .gallery-item img {
        width: 100%;
        height: 280px; /* Fixed height for squares */
        object-fit: cover;
        display: block;
        transition: transform 0.5s ease;
    }

    /* Hover Effects */
    .gallery-item:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(255, 127, 0, 0.5);
        border-color: #FF7F00;
    }

    .gallery-item:hover img {
        transform: scale(1.1);
        filter: brightness(0.7);
    }

    /* Overlay Text */
    .gallery-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(transparent, rgba(0,0,0,0.9));
        color: white;
        padding: 15px;
        opacity: 0;
        transition: opacity 0.3s ease;
        text-align: center;
    }

    .gallery-item:hover .gallery-overlay {
        opacity: 1;
    }

    .gallery-title {
        color: #FFD700;
        font-weight: 700;
        margin: 0;
        text-transform: uppercase;
        font-size: 0.9rem;
    }
</style>

<div class="gallery-container">
    <div style="text-align: center; margin-bottom: 40px;">
        <h1 style="color: #fff; font-weight: 900; text-transform: uppercase;">Our Gallery</h1>
        <div style="width: 60px; height: 4px; background: #FF7F00; margin: 10px auto;"></div>
    </div>

    <div class="gallery-grid">
        @foreach (var item in Model)
        {
            <div class="gallery-item">
                <img src="@item.ImageUrl" alt="@item.Title" />
                <div class="gallery-overlay">
                    <p class="gallery-title">@item.Title</p>
                </div>
            </div>
        }
    </div>
</div>