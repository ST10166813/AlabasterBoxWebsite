@{
    ViewData["Title"] = "Forgot Password";
}

<style>
    :root {
        --bg: #08090c;
        --ink: #f2f2f2;
        --muted: #cfcfd6;
        --glass-1: rgba(18,18,22,.55);
        --glass-2: rgba(18,18,22,.35);
        --glass-brd: rgba(255,255,255,.14);
        --gold: #FFD700;
        --shadow: 0 24px 60px rgba(0,0,0,.55);
    }

    /* ===== Base & wallpaper layers =====
       Wallpaper is provided by body::before using Url.Content so "~" resolves correctly.
       A subtle dim tint is applied with body::after for consistent legibility.
    */
    html, body {
        height: 100%;
        margin: 0;
        font-family: 'Poppins','Segoe UI',system-ui,-apple-system,sans-serif;
        color: var(--ink);
        background: transparent;
        overflow-x: hidden;
        position: relative;
    }

        /* wallpaper layer */
        body::before {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -3;
            pointer-events: none;
            background-image: url('@Url.Content("~/images/4.jpg")');
            background-position: center 100%;
            background-size: cover;
            background-repeat: no-repeat;
            background-attachment: fixed;
            filter: saturate(1.02) brightness(0.88);
            will-change: transform;
        }

        /* dim overlay for contrast */
        body::after {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -2;
            pointer-events: none;
            background: rgba(0,0,0,0.45);
        }

    /* ensure site chrome sits above the wallpaper */
    header, nav, .center-wrapper, .auth-card {
        position: relative;
        z-index: 1;
    }

    /* ===== Wrapper (closer to navbar) ===== */
    .center-wrapper {
        min-height: calc(100vh - 160px);
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding-top: 120px;
        padding-bottom: 60px;
        position: relative;
        z-index: 1;
    }

    /* ===== Card =====
       Use transition for reveal (no keyframes).
    */
    .auth-card {
        width: min(620px, 94vw);
        padding: 2.6rem 2rem;
        border-radius: 20px;
        border: 1px solid var(--glass-brd);
        background: linear-gradient(180deg, var(--glass-1), var(--glass-2));
        box-shadow: var(--shadow);
        backdrop-filter: blur(18px) saturate(140%);
        -webkit-backdrop-filter: blur(18px) saturate(140%);
        text-align: center;
        opacity: 0;
        transform: translateY(40px);
        transition: opacity .6s cubic-bezier(.16,.84,.24,1), transform .6s cubic-bezier(.16,.84,.24,1);
    }

        /* revealed state (added by JS) */
        .auth-card.visible {
            opacity: 1;
            transform: translateY(0);
        }

    /* ===== Heading ===== */
    h1.page-title {
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 1.9rem;
        font-weight: 900;
        color: #fff;
        text-shadow: 0 2px 6px rgba(0,0,0,.6);
        margin-bottom: .5rem;
    }

    p.page-sub {
        color: #e2e2e2;
        font-size: 1rem;
        margin-bottom: 1.8rem;
    }

    /* ===== Input ===== */
    label {
        font-weight: 600;
        font-size: .95rem;
        color: #fff;
        text-align: left;
        display: block;
        margin-bottom: 6px;
    }

    .input-wrap {
        position: relative;
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 12px;
        background: linear-gradient(180deg, rgba(255,255,255,.10), rgba(255,255,255,.05));
        padding: 10px 14px;
        height: 48px;
        transition: box-shadow .22s ease, border-color .22s ease, background .22s ease;
    }

        .input-wrap:focus-within {
            border-color: rgba(255,215,0,.55);
            box-shadow: 0 0 12px rgba(255,215,0,.28);
            background: linear-gradient(180deg, rgba(255,255,255,.14), rgba(255,255,255,.06));
        }

    .input-icon {
        color: #fff;
        font-size: 1.1rem;
        opacity: .9;
    }

    /* Transparent, white input (no white box) */
    .auth-card .form-control,
    .auth-card input.form-control,
    .auth-card textarea.form-control,
    .auth-card select.form-control {
        flex: 1;
        background: transparent !important;
        color: #fff !important;
        border: 0 !important;
        outline: none !important;
        box-shadow: none !important;
        font-size: 1rem;
        padding: 8px 2px;
        caret-color: var(--gold);
    }

        /* White placeholders */
        .auth-card .form-control::placeholder {
            color: #fff !important;
            opacity: 0.8;
        }

    /* Remove blue outline */
    .auth-card input:focus,
    .auth-card textarea:focus,
    .auth-card select:focus {
        outline: none !important;
        box-shadow: none !important;
    }

    /* Kill Chrome autofill white background */
    .auth-card input:-webkit-autofill,
    .auth-card textarea:-webkit-autofill,
    .auth-card select:-webkit-autofill {
        -webkit-text-fill-color: #fff !important;
        caret-color: var(--gold);
        transition: background-color 999999s ease-out, color 999999s ease-out;
        -webkit-box-shadow: 0 0 0px 1000px transparent inset !important;
        box-shadow: 0 0 0px 1000px transparent inset !important;
    }

    /* ===== Buttons ===== */
    .btn-primary {
        display: block;
        width: 100%;
        margin-top: 1.4rem;
        background: linear-gradient(135deg, var(--gold), #FFB700, var(--gold));
        color: #181818;
        font-weight: 800;
        font-size: 1rem;
        border: 1px solid rgba(255,215,0,.4);
        border-radius: 12px;
        padding: 12px 16px;
        box-shadow: 0 10px 26px rgba(255,215,0,.25);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 18px 36px rgba(255,215,0,.35);
        }

    .btn-alt {
        display: block;
        width: 100%;
        margin-top: 0.8rem;
        background: transparent;
        color: var(--gold);
        font-weight: 700;
        font-size: 0.95rem;
        border: none;
        text-decoration: none;
        transition: color .2s ease;
    }

        .btn-alt:hover {
            color: #fff;
            text-decoration: underline;
        }

    /* ===== Alerts (use transitions; reveal class added by JS) ===== */
    .alert {
        background: rgba(46,204,113,.15);
        border: 1px solid rgba(46,204,113,.3);
        color: #e9ffe9;
        padding: 10px 12px;
        border-radius: 10px;
        margin-bottom: 12px;
        opacity: 0;
        transform: translateY(-6px);
        transition: opacity .42s ease, transform .42s ease;
    }

        .alert.show {
            opacity: 1;
            transform: none;
        }

    .alert-danger {
        background: rgba(255,77,77,.15);
        border: 1px solid rgba(255,77,77,.3);
        color: #ffe2e2;
    }
</style>

<div class="center-wrapper">
    <div class="auth-card" id="authCard" role="main" aria-labelledby="forgotTitle">
        <h1 class="page-title" id="forgotTitle">Forgot Password</h1>
        <p class="page-sub">Enter your email below to receive a reset link.</p>

        @if (!string.IsNullOrEmpty(ViewBag.Message as string))
        {
            <div class="alert" id="messageAlert">@ViewBag.Message</div>
        }
        @if (!string.IsNullOrEmpty(ViewBag.Error as string))
        {
            <div class="alert alert-danger" id="errorAlert">@ViewBag.Error</div>
        }

        <form method="post" novalidate>
            <label for="forgotEmail">Email Address</label>
            <div class="input-wrap" aria-labelledby="forgotEmailLabel">
                <i class="bi bi-envelope input-icon" aria-hidden="true"></i>
                <input type="email" name="email" id="forgotEmail" class="form-control" placeholder="Enter your email address" required />
            </div>

            <button type="submit" class="btn-primary">Send Reset Link</button>
            <a href="/Auth/Login" class="btn-alt">Back to Login</a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Reveal the card and any alerts using class toggles (no keyframes).
        (function () {
          document.addEventListener('DOMContentLoaded', () => {
            const card = document.getElementById('authCard');
            if (card) requestAnimationFrame(() => card.classList.add('visible'));

            // reveal any alerts if they exist
            const msg = document.getElementById('messageAlert');
            const err = document.getElementById('errorAlert');
            [msg, err].forEach(a => { if (a) requestAnimationFrame(() => a.classList.add('show')); });
          });
        })();
    </script>
}
