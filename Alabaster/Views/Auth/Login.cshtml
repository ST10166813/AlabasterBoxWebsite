@{
    ViewData["Title"] = "Login";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

<style>
    :root {
        --bg: #08090c;
        --ink: #f2f2f2;
        --muted: #cfcfd6;
        --glass-1: rgba(18,18,22,.55);
        --glass-2: rgba(18,18,22,.35);
        --glass-brd: rgba(255,255,255,.14);
        --gold: #FFD700;
        --gold-ink: #181818;
        --shadow: 0 24px 60px rgba(0,0,0,.55);
    }

    /* ===== Base & background layers (Razor-friendly) =====
               Wallpaper is in body::before using Url.Content so "~" resolves correctly.
               body::after is a subtle noise/dim layer.
            */
    html, body {
        font-family: 'Poppins','Segoe UI',system-ui,-apple-system,sans-serif;
        min-height: 100dvh;
        height: auto;
        overflow-y: auto;
        overflow-x: hidden;
        color: var(--ink);
        background: transparent; /* actual image is provided by pseudo element */
        margin: 0;
        position: relative;
    }

        /* wallpaper image layer */
        body::before {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -3;
            pointer-events: none;
            background-image: url('@Url.Content("~/images/4.jpg")');
            background-position: center -10%;
            background-size: cover;
            background-repeat: no-repeat;
            background-attachment: fixed;
            filter: saturate(1.02) brightness(0.86);
            will-change: transform;
        }

        /* subtle film/tint/noise overlay */
        body::after {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -2;
            pointer-events: none;
            background: rgba(0, 0, 0, 0.296);
        }

    /* make header/nav always above the wallpaper */
    header, nav, .main-wrapper, .auth-container {
        position: relative;
        z-index: 1;
    }

    /* ===== Stage wrapper (reveal via transition, no keyframes) ===== */
    .main-wrapper {
        position: relative;
        z-index: 1;
        min-height: 100dvh;
        width: 100vw;
        display: grid;
        place-items: start center;
        padding: clamp(8px, 2.5vw, 18px) 2vw 24px;
        opacity: 0;
        transform: translateY(10px);
        transition: opacity .56s ease, transform .56s cubic-bezier(.2,.9,.25,1);
    }

        .main-wrapper.visible {
            opacity: 1;
            transform: none;
        }

    /* ===== Auth Card: use flex so it can naturally wrap on smaller widths (no media queries) ===== */
    .auth-container {
        display: flex;
        gap: 0;
        flex-wrap: wrap;
        align-items: stretch;
        width: min(1200px, 92vw);
        max-height: min(780px, 92dvh);
        border-radius: 22px;
        border: 1px solid var(--glass-brd);
        background: linear-gradient(180deg, var(--glass-1), var(--glass-2));
        backdrop-filter: blur(16px) saturate(140%);
        -webkit-backdrop-filter: blur(16px) saturate(140%);
        box-shadow: var(--shadow);
        overflow-y: auto;
        overscroll-behavior: contain;
        -webkit-overflow-scrolling: touch;
    }

    /* Left form area: prefers ~60% but will shrink on narrow screens */
    .auth-form {
        flex: 1 1 60%;
        min-width: 320px;
        padding: clamp(18px, 3vw, 32px) clamp(16px, 2.2vw, 28px);
        display: grid;
        gap: clamp(10px, 1.2vw, 16px);
        align-content: start;
        box-sizing: border-box;
    }

    /* Right brand area: prefers ~36% */
    .brand-panel {
        flex: 0 1 36%;
        min-width: 260px;
        position: relative;
        background: radial-gradient(80% 70% at 70% 30%, rgba(255,215,0,.14), transparent 60%), linear-gradient(180deg, rgba(255,255,255,.07), rgba(255,255,255,.02));
        border-left: 1px solid var(--glass-brd);
        display: grid;
        place-items: center;
        padding: clamp(16px, 2.4vw, 24px);
        box-sizing: border-box;
    }

        .brand-panel::after {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(40% 35% at 50% 50%, rgba(207,200,145,0.08), transparent 80%);
            mix-blend-mode: screen;
        }

    .brand-figure {
        width: min(360px, 62%);
        aspect-ratio: 1;
        background: url('@Url.Content("~/Images/whitelogo.png")') center/contain no-repeat;
        filter: drop-shadow(0 12px 28px rgba(0,0,0,.45));
        opacity: .95;
    }

    /* ===== Headings & text ===== */
    .auth-kicker {
        font-weight: 800;
        letter-spacing: .14em;
        text-transform: uppercase;
        font-size: .78rem;
        color: #b9b9c4;
    }

    .auth-title {
        font-size: clamp(1.6rem, 2.4vw, 2.1rem);
        font-weight: 900;
        line-height: 1.15;
        background: linear-gradient(90deg, var(--gold), #ffffff 45%, #c6c6c6);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        text-shadow: 0 0 18px rgba(255,255,255,.18);
        margin-top: 4px;
    }

    /* ===== Form elements ===== */
    form {
        display: grid;
        gap: 12px;
        margin-top: 4px;
    }

    .form-row {
        display: grid;
        gap: 8px;
        min-width: 0;
    }

    label.form-label {
        font-weight: 700;
        font-size: .95rem;
        color: #efefef;
    }

    .input-wrap {
        position: relative;
        display: flex;
        align-items: center;
        border: 1px solid rgba(255,255,255,.14);
        background: linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.03));
        border-radius: 14px;
        padding: 10px 12px;
        transition: border-color .25s ease, box-shadow .25s ease, background .25s ease;
    }

        .input-wrap:focus-within {
            border-color: rgba(255,215,0,.55);
            box-shadow: 0 0 0 6px rgba(255,215,0,.10);
            background: linear-gradient(180deg, rgba(255,255,255,.12), rgba(255,255,255,.05));
        }

    .input-icon {
        font-size: 1.05rem;
        margin-right: 10px;
        opacity: .9;
    }

    input.form-control {
        flex: 1;
        border: 0;
        outline: 0;
        background: transparent !important;
        color: var(--ink) !important;
        font-size: .98rem;
        padding: 8px 4px;
        caret-color: var(--gold);
    }

    input::placeholder {
        color: #bdbdc5;
        opacity: .85;
    }

    input:focus, .form-control:focus, textarea:focus, select:focus, button:focus {
        outline: none !important;
        box-shadow: none !important;
        border-color: transparent !important;
    }

    /* autofill fixes */
    input:-webkit-autofill, input:-webkit-autofill:hover, input:-webkit-autofill:focus {
        -webkit-text-fill-color: var(--ink);
        transition: background-color 9999s ease-in-out 0s;
        box-shadow: 0 0 0px 1000px rgba(0,0,0,0) inset !important;
        caret-color: var(--gold);
    }

    .toggle-pass {
        border: 0;
        outline: 0;
        background: transparent;
        color: #e7e7ee;
        font-size: 1.05rem;
        cursor: pointer;
        padding: 6px;
        border-radius: 8px;
    }

        .toggle-pass:hover {
            color: var(--gold);
        }

        .toggle-pass:focus {
            outline: none !important;
            box-shadow: none !important;
        }

    .help-line {
        font-size: .82rem;
        color: #c7c7d1;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* ===== Buttons ===== */
    .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        background: linear-gradient(135deg, var(--gold), #FFB700, var(--gold));
        color: var(--gold-ink);
        border: 1px solid rgba(255,215,0,.5);
        border-radius: 12px;
        font-weight: 900;
        font-size: .98rem;
        padding-block: 12px;
        padding-inline: 16px;
        box-shadow: 0 10px 26px rgba(255,215,0,.28);
        transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
        width: 100%;
    }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 16px 38px rgba(255,215,0,.38);
            filter: saturate(1.05);
        }

        .btn-primary:disabled {
            opacity: .65;
            cursor: not-allowed;
        }

    .btn-google {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        background: linear-gradient(135deg,#db4437,#e85549);
        color: #fff;
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 12px;
        font-weight: 800;
        font-size: .96rem;
        padding-block: 12px;
        padding-inline: 16px;
        box-shadow: 0 10px 24px rgba(219,68,55,.35);
        width: 100%;
        transition: transform .18s ease, box-shadow .18s ease;
    }

        .btn-google:hover {
            transform: translateY(-1px);
            box-shadow: 0 16px 36px rgba(219,68,55,.5);
        }

    /* links and hr */
    .meta-links {
        display: grid;
        gap: 6px;
        justify-items: center;
        text-align: center;
        margin-top: 6px;
        font-size: .9rem;
        color: var(--muted);
    }

        .meta-links a {
            color: #d9d9e4;
            font-weight: 700;
            text-decoration: none;
        }

            .meta-links a:hover {
                color: #fff;
                text-decoration: underline;
            }

    .hr {
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,.18), transparent);
        margin: 12px 0 8px;
    }

    /* alerts — start hidden, then revealed by JS adding .show */
    .alert {
        font-size: .85rem;
        padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,.16);
        background: linear-gradient(180deg, rgba(255,255,255,.10), rgba(255,255,255,.04));
        opacity: 0;
        transform: translateY(-6px);
        transition: opacity .42s ease, transform .42s ease;
    }

        .alert.show {
            opacity: 1;
            transform: none;
        }

    .alert-success {
        color: #b6ffb7;
        border-color: rgba(0,255,0,.25);
    }

    .alert-danger {
        color: #ffc6c6;
        border-color: rgba(255,0,0,.25);
    }

    /* small helpers */
    .hidden-visually {
        position: absolute !important;
        height: 1px;
        width: 1px;
        overflow: hidden;
        clip: rect(1px,1px,1px,1px);
        white-space: nowrap;
    }

    .container-pad {
        padding-inline: clamp(12px, 4vw, 36px);
    }
</style>

<div class="main-wrapper" id="mainWrapper">
    <div class="auth-container" role="region" aria-labelledby="loginHeading">

        <!-- LEFT: FORM -->
        <div class="auth-form">
            <div>
                <div class="auth-kicker">Welcome back</div>
                <h1 class="auth-title" id="loginHeading">Sign in to continue</h1>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success" id="successAlert">@TempData["Success"]</div>
            }

            @if (!string.IsNullOrEmpty(ViewBag.Error as string))
            {
                <div class="alert alert-danger" id="errorAlert">@ViewBag.Error</div>
            }

            <form method="post" asp-action="Login" novalidate>
                <!-- Email -->
                <div class="form-row">
                    <label for="loginEmail" class="form-label">Email</label>
                    <div class="input-wrap" role="group" aria-labelledby="emailLabel">
                        <i class="bi bi-envelope input-icon" aria-hidden="true"></i>
                        <input type="email" name="email" id="loginEmail" class="form-control"
                               placeholder="you@example.com" inputmode="email" autocomplete="email" required />
                    </div>
                    <div class="help-line" aria-hidden="true">
                        <i class="bi bi-info-circle"></i><span>Use the email you registered with.</span>
                    </div>
                </div>

                <!-- Password -->
                <div class="form-row">
                    <label for="loginPassword" class="form-label">Password</label>
                    <div class="input-wrap">
                        <i class="bi bi-shield-lock input-icon" aria-hidden="true"></i>
                        <input type="password" name="password" id="loginPassword" class="form-control"
                               placeholder="Your secure password" autocomplete="current-password" required />
                        <button type="button" class="toggle-pass" aria-label="Show password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <div class="help-line" aria-hidden="true">
                        <i class="bi bi-key"></i><span>Passwords are case-sensitive.</span>
                    </div>
                </div>

                <!-- Submit -->
                <button type="submit" class="btn-primary" id="loginSubmit">
                    <span class="btn-text">Sign in</span>
                    <span class="btn-spinner" style="display:none;"><i class="bi bi-arrow-repeat bi-spin"></i></span>
                </button>

                <div class="meta-links" role="navigation" aria-label="Auth links">
                    <a href="/Auth/ForgotPassword">Forgot Password?</a>
                    <div>Don’t have an account? <a href="/Auth/Register">Register</a></div>
                </div>

                <div class="hr" aria-hidden="true"></div>

                @* Uncomment if you re-enable Google sign-in: <button id="googleSigninBtn" ...> *@
            </form>
        </div>

        <!-- RIGHT: BRAND -->
        <aside class="brand-panel" aria-hidden="true">
            <div class="brand-figure" role="img" aria-label="Site logo"></div>
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        // Reveal wrapper and any alerts using class toggles (no keyframes, no media queries)
        (function () {
            // reveal main wrapper
            document.addEventListener('DOMContentLoaded', () => {
                const wrapper = document.getElementById('mainWrapper');
                if (wrapper) requestAnimationFrame(() => wrapper.classList.add('visible'));

                // reveal alerts if present
                const success = document.getElementById('successAlert');
                const error = document.getElementById('errorAlert');
                [success, error].forEach(a => {
                    if (a) requestAnimationFrame(() => a.classList.add('show'));
                });
            });

            // password toggle
            const passInput = document.getElementById('loginPassword');
            const toggleBtn = document.querySelector('.toggle-pass');
            toggleBtn?.addEventListener('click', () => {
                if (!passInput) return;
                const isHidden = passInput.type === 'password';
                passInput.type = isHidden ? 'text' : 'password';
                toggleBtn.innerHTML = isHidden ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
            });

            // submit button behaviour (disable + spinner)
            const submitBtn = document.getElementById('loginSubmit');
            const form = document.querySelector('form[asp-action="Login"]');
            form?.addEventListener('submit', () => {
                if (!submitBtn) return;
                submitBtn.disabled = true;
                const text = submitBtn.querySelector('.btn-text');
                const spinner = submitBtn.querySelector('.btn-spinner');
                if (text) text.style.display = 'none';
                if (spinner) spinner.style.display = 'inline-flex';
            });
        })();
    </script>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/9.23.0/firebase-app.js";
        import { getAuth, GoogleAuthProvider, signInWithPopup } from "https://www.gstatic.com/firebasejs/9.23.0/firebase-auth.js";

        const firebaseConfig = {
            apiKey: "AIzaSyBEjxaEf_S9x9NZhmJrWwHLDdZvoyDajDg",
            authDomain: "alabaster-8cfcd.firebaseapp.com",
            projectId: "alabaster-8cfcd",
            storageBucket: "alabaster-8cfcd.appspot.com",
            messagingSenderId: "1014314025942",
            appId: "1:1014314025942:web:fedff22641b2b8bd219a77"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const provider = new GoogleAuthProvider();
        provider.setCustomParameters({ prompt: 'select_account' });

        const googleBtn = document.getElementById("googleSigninBtn");
        googleBtn?.addEventListener("click", async () => {
            try {
                const result = await signInWithPopup(auth, provider);
                const idToken = await result.user.getIdToken();
                const resp = await fetch("/Auth/GoogleLogin", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(idToken)
                });

                const data = await resp.json();
                if (data.success) window.location.href = "/Home/Index";
                else alert("Google Login failed: " + data.error);
            } catch (err) {
                alert("Google Sign-In Error: " + (err?.message || err));
            }
        });
    </script>
}
