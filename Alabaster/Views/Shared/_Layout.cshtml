@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Alabaster.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Lexend+Giga:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --nav-h: clamp(68px, 12vw, 110px);
            --footer-h: 64px;
        }

        /* ===== Base ===== */
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100%;
            overflow-x: hidden;
            overflow-y: auto;
            background: transparent !important;
        }

        body {
            font-family: "Poppins",system-ui,sans-serif;
            color: #fff;
            position: relative;
        }

        /* Fixed stray bracket here */
        body::before {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -2;
            pointer-events: none;
            background-image: url('https://static.vecteezy.com/system/resources/thumbnails/074/134/155/small_2x/sunlight-shines-through-stained-glass-windows-in-a-church-photo.jpg');
            background-position: center -10%;
            background-size: cover;
            background-repeat: no-repeat;
            background-attachment: fixed;
            -webkit-transform: translateZ(0);
            filter: saturate(1.03) brightness(0.86);
        }

        body::after {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -1;
            background: linear-gradient(180deg, rgba(6,6,8,0.40), rgba(12,12,14,0.20) 40%, rgba(12,12,14,0.18));
            pointer-events: none;
        }

        /* ===== Particles ===== */
        #particles {
            position: fixed;
            inset: 0;
            pointer-events: none;
            overflow: hidden;
            z-index: 0;
        }

        .particle {
            position: absolute;
            background: rgba(247,246,244,.8);
            border-radius: 50%;
            filter: blur(2px);
            animation: float 12s linear infinite;
            will-change: transform, opacity;
        }

        @@keyframes float {
            0% { transform: translateY(100vh) translateX(0) rotate(0deg); opacity: 0; }
            10% { opacity: 1; }
            100% { transform: translateY(-10vh) translateX(50vw) rotate(360deg); opacity: 0; }
        }

        /* ===== Nav Guard ===== */
        .nav-guard {
            position: fixed;
            top: 0; left: 0; right: 0;
            height: var(--nav-h);
            z-index: 1000;
            background: linear-gradient(180deg, rgba(8,8,10,.78), rgba(16,16,20,.62) 60%, rgba(16,16,20,0));
            border-bottom: 1px solid rgba(255,255,255,.12);
            backdrop-filter: blur(14px) saturate(140%);
            -webkit-backdrop-filter: blur(14px) saturate(140%);
            box-shadow: 0 10px 30px rgba(0,0,0,.35);
            transition: all .25s ease;
            pointer-events: none;
        }

        body.scrolled .nav-guard {
            height: calc(var(--nav-h) - 16px);
            background: linear-gradient(180deg, rgba(8,8,10,.86), rgba(16,16,20,.72) 60%, rgba(16,16,20,0));
        }

        /* ===== Navigation Links & Auth ===== */
        .top-words {
            position: fixed;
            left: 50%;
            transform: translateX(-50%);
            top: calc( (var(--nav-h) - 28px) / 2 );
            display: flex;
            gap: clamp(18px,4vw,70px);
            z-index: 1002;
            font-weight: 600;
            text-transform: uppercase;
            white-space: nowrap;
            transition: all .25s ease;
        }

        body.scrolled .top-words { top: calc( (var(--nav-h) - 16px - 28px) / 2 ); }

        .top-words a { color: #f1f1f1; text-decoration: none; opacity: .9; transition: all .2s; }
        .top-words a:hover { opacity: 1; transform: translateY(-1px); }

        .auth-links {
            position: fixed;
            right: 20px;
            top: calc( (var(--nav-h) - 32px) / 2 );
            z-index: 1002;
            display: flex;
            gap: 16px;
            align-items: center;
            font-weight: 700;
            text-transform: uppercase;
            transition: all .25s ease;
        }

        body.scrolled .auth-links { top: calc( (var(--nav-h) - 16px - 32px) / 2 ); }

        /* ===== Hamburger & Drawer ===== */
        .hamburger-icon {
            position: fixed;
            top: 18px; left: 18px;
            z-index: 1055;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 56px; height: 56px;
            border-radius: 14px;
            cursor: pointer;
            background: linear-gradient(180deg, rgba(10,10,12,.82), rgba(18,18,22,.72));
            border: 1px solid rgba(255,255,255,.12);
            backdrop-filter: blur(14px);
            box-shadow: 0 10px 28px rgba(0,0,0,.45);
        }

        .hamburger-icon::before {
            content: "";
            position: absolute;
            width: 26px; height: 2px;
            background: #fff;
            box-shadow: 0 7px 0 #fff, 0 -7px 0 #fff;
        }

        .side-drawer {
            position: fixed;
            top: 0; left: 0;
            height: 100dvh;
            width: 0;
            z-index: 1100;
            overflow: hidden;
            transition: width .35s ease;
            background: linear-gradient(180deg, rgba(10,10,12,.95), rgba(16,16,20,.90));
            backdrop-filter: blur(18px);
            border-right: 1px solid rgba(255,255,255,.12);
        }

        .side-drawer-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 14px 16px; border-bottom: 1px solid rgba(255,255,255,.12);
            font-weight: 800;
        }

        .menu-item {
            display: flex; align-items: center; gap: 10px;
            padding: 12px 14px; margin: 6px;
            border-radius: 12px; color: #f1f1f1; text-decoration: none;
            background: rgba(255,255,255,.05);
            transition: 0.2s;
        }

        .menu-item:hover { transform: translateX(4px); background: rgba(255,255,255,.12); }

        /* ===== RESPONSIVE FIXES ===== */
/* Use DOUBLE @@ here */
@@media (max-width: 1024px) {
    .top-words { display: none; }
    .auth-links { right: 15px; font-size: 0.8rem; }
}

/* Use DOUBLE @@ here */
@@media (max-width: 480px) {
    .auth-links span { display: none; }
    .hamburger-icon { left: 12px; top: 12px; width: 48px; height: 48px; }
    #sideDrawer { max-width: 85vw; }
}

        .page-wrapper {
            position: relative; z-index: 1;
            padding-top: calc(var(--nav-h) + 16px);
            padding-bottom: calc(var(--footer-h) + 24px);
        }

        footer.site-footer {
            position: fixed; left: 0; right: 0; bottom: 0;
            height: var(--footer-h);
            background: rgba(8,8,10,.85);
            backdrop-filter: blur(14px);
            display: flex; align-items: center; justify-content: center;
            z-index: 2000; font-size: .92rem;
        }

        .overlay {
            position: fixed; inset: 0; z-index: 1090;
            display: none; background: rgba(0,0,0,.45);
            backdrop-filter: blur(2px);
        }
    </style>
@await RenderSectionAsync("Styles", required: false)

</head>
<body>
    <div class="nav-guard" aria-hidden="true"></div>
    <div id="particles" aria-hidden="true"></div>
    <button class="hamburger-icon" aria-label="Open menu" onclick="openDrawer()"></button>

    @{ var isAdmin = Context.Session.GetString("IsAdmin") == "true"; }

    <nav class="top-words">
        <a href="/">Home</a>
        <a href="/AboutUs">About Us</a>
        <a href="/Events">Events</a>
        <a href="/Events/Volunteer">Volunteer</a>
        <a href="/Prayer/Index">Prayer Requests</a>
        <a href="/Testimonies">Testimonies</a>
    </nav>

    <div class="auth-links">
        @if (Context.Session.GetString("FirebaseToken") != null)
        {
            <span>@(Context.Session.GetString("UserName") ?? "User")</span>
            <a asp-controller="Auth" asp-action="Logout">Logout</a>
        }
        else
        {
            <a asp-controller="Auth" asp-action="Login">Login</a>
            <a asp-controller="Auth" asp-action="Register">Register</a>
        }
    </div>

    <div id="sideDrawer" class="side-drawer">
        <div class="side-drawer-header">
            <span>MENU</span>
            <button class="close-btn" onclick="closeDrawer()"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="menu-links">
            @if (isAdmin) {
                <div class="drawer-section">Admin</div>
                <a class="menu-item" asp-controller="Prayer" asp-action="AdminView"><i class="bi bi-journal-bookmark-fill"></i> Prayer Requests</a>
                <a class="menu-item" asp-controller="Testimonies" asp-action="Admin"><i class="bi bi-chat-heart-fill"></i> Manage Testimonies</a>
            }
            <div class="drawer-section">Main</div>
            <a class="menu-item" href="/"><i class="bi bi-house"></i> Home</a>
            <a class="menu-item" href="/AboutUs"><i class="bi bi-info-circle"></i> About Us</a>
            <a class="menu-item" href="/Gallery"><i class="bi bi-images"></i> Gallery</a>
            <a class="menu-item" href="/Events"><i class="bi bi-calendar-event"></i> Events</a>
            <a class="menu-item" href="/Testimonies"><i class="bi bi-chat-quote"></i> Testimonies</a>
            <a class="menu-item" href="/Events/Volunteer"><i class="bi bi-person-lines-fill"></i> Volunteer</a>
            <a class="menu-item" href="/Prayer/Index"><i class="bi bi-journal-bookmark-fill"></i> Prayer Requests</a>
            <a class="menu-item" href="/Donate"><i class="bi bi-heart"></i> Donate</a>
        </div>
    </div>

    <div id="menuOverlay" class="overlay" onclick="closeDrawer()"></div>

    <div class="page-wrapper">
        <main role="main">@RenderBody()</main>
    </div>

    <footer class="site-footer">
        <p><span id="year"></span> © Alabaster Ministry &bull; Built by <strong>404 Found</strong></p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function openDrawer(){
            const d = document.getElementById('sideDrawer');
            const o = document.getElementById('menuOverlay');
            d.style.width = window.innerWidth < 500 ? '85vw' : '340px'; 
            o.style.display = 'block';
        }
        function closeDrawer(){
            document.getElementById('sideDrawer').style.width = '0';
            document.getElementById('menuOverlay').style.display = 'none';
        }

        (function(){
            function onScroll(){ document.body.classList.toggle('scrolled', window.scrollY > 10); }
            window.addEventListener('scroll', onScroll);
            document.getElementById('year').textContent = new Date().getFullYear();
        })();
    </script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>