@section Scripts {
            <script>
                /* Retriggering scroll animations to keep the page lively */
                const reveals = document.querySelectorAll('.reveal, .fade-left, .fade-right');
                const io = new IntersectionObserver((entries)=>{
                  entries.forEach(entry=>{
                    if (entry.isIntersecting) {
                      entry.target.classList.add('show');
                    } else {
                      entry.target.classList.remove('show'); // allows re-animate on reverse scroll
                    }
                  });
                },{ threshold: 0.18 });
                revelsInit();
                function revelsInit(){ reveals.forEach(el=>io.observe(el)); }
            </script>
}
