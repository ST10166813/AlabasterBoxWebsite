@{
    ViewData["Title"] = "Home Page";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --gold: #FFD700;
            --gold2: #FFB300;
            --ink: #fff;
            --muted: #d1d1d1;
            --shadow-ink-weak: 0 2px 6px rgba(0,0,0,.85);
            --shadow-ink-strong: 0 3px 10px rgba(0,0,0,.92), 0 8px 26px rgba(0,0,0,.55);
        }

        /* ===== BASE ===== */
        html, body {
            margin: 0;
            padding: 0;
            font-family: 'Poppins','Segoe UI',sans-serif;
            color: #fff;
            overflow-x: hidden;
            scroll-behavior: smooth;
            /* Global readable shadow for most text */
            text-shadow: var(--shadow-ink-weak);
        }

        /* Make sure literally all common text elements are white + shadow */
        h1, h2, h3, h4, h5, h6, p, a, li, span, small, label, summary, button, dt, dd, figcaption, .name, .strip .item span, .faq * {
            color: #fff !important;
            text-shadow: var(--shadow-ink-weak);
        }

        /* ===== LAYOUT ===== */
        section {
            padding: 68px 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 36px;
            flex-wrap: wrap;
            text-align: left;
        }

            section.compact {
                padding: 36px 20px;
            }

            section:nth-of-type(even):not(.compact) {
                flex-direction: row-reverse;
            }

            section img {
                width: 460px;
                height: 360px;
                object-fit: cover;
                border-radius: 18px;
                box-shadow: 0 10px 34px rgba(0,0,0,.45);
            }

            section .content {
                max-width: 620px;
            }

        /* ===== HEADINGS (white + strong black shadow) ===== */
        h1, h2 {
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .8px;
            /* remove gradient fill and use solid white for stronger contrast */
            background: none !important;
            -webkit-background-clip: initial;
            background-clip: initial;
            color: #fff !important;
            text-shadow: var(--shadow-ink-strong);
            margin: 0 0 .6rem;
        }

        h1 {
            font-size: clamp(2.2rem,4.8vw,3.2rem);
            text-align: center;
            width: 100%;
        }

        h2 {
            font-size: clamp(1.6rem,3.6vw,2.2rem);
        }

        /* Paragraphs remain white with subtle shadow for readability */
        p {
            font-size: 1.03rem;
            line-height: 1.7;
            color: #fff !important; /* override muted */
            margin: 0 0 .8rem;
        }

        /* ===== BUTTON ===== */
        .btn {
            display: inline-block;
            margin-top: 8px;
            padding: 10px 26px;
            font-weight: 600;
            border-radius: 42px;
            text-decoration: none;
            color: #111; /* keep legible on gold */
            background: linear-gradient(135deg,var(--gold),var(--gold2));
            box-shadow: 0 8px 22px rgba(0,0,0,.45);
            transition: transform .2s ease, box-shadow .2s ease, filter .2s ease;
        }

            .btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 14px 34px rgba(0,0,0,.55);
                filter: brightness(1.05);
            }

        /* ===== MINI STRIP (Quick Links) ===== */
        .strip {
            display: grid;
            grid-template-columns: repeat(2, minmax(160px,1fr));
            gap: 12px;
            width: 100%;
            max-width: 1100px;
        }

            .strip .item {
                display: grid;
                place-items: center;
                gap: 6px;
                text-align: center;
                padding: 10px 8px;
                border-radius: 12px;
                border: 1px solid rgb(255, 255, 255);
                background: linear-gradient(180deg, rgba(10, 10, 10, 0), rgba(255,255,255,.06));
                transition: transform .15s ease, border-color .2s ease, box-shadow .2s ease;
            }

                .strip .item:hover {
                    transform: translateY(-2px);
                    border-color: rgba(255,215,0,.45);
                    box-shadow: 0 12px 32px rgba(0,0,0,.5);
                }

            .strip i {
                font-size: 1.2rem;
                opacity: .95;
            }

        /* ===== TESTIMONIES HIGHLIGHTS ===== */
        .quotes {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 14px;
            width: 100%;
            max-width: 1100px;
        }

        .quote {
            border: 1px solid rgba(255,255,255,.18);
            border-radius: 14px;
            padding: 16px 14px;
            background: linear-gradient(180deg, rgba(8, 8, 8, 0.319), rgba(255,255,255,.06));
            box-shadow: 0 10px 28px rgba(0,0,0,.5);
        }

            .quote p {
                margin: 0;
                font-size: .98rem;
            }

            .quote .name {
                margin-top: 8px;
                font-size: .9rem;
                opacity: .95;
            }

        /* ===== FAQ – HIGH VISIBILITY ===== */
        .faq {
            width: 100%;
            max-width: 900px;
        }

            .faq details {
                border: 1px solid rgba(255, 217, 0, 0.212);
                border-radius: 15px;
                background: linear-gradient(180deg, rgba(8, 8, 8, 0.067), rgba(22, 22, 22, 0.149));
                padding: 14px 16px;
                margin-bottom: 12px;
                box-shadow: 0 12px 28px rgba(0,0,0,.55);
                transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
            }

                .faq details[open] {
                    border-color: rgb(255, 255, 255);
                    box-shadow: 0 16px 36px rgba(121, 121, 121, 0.33);
                    background: linear-gradient(180deg, rgba(162, 162, 162, 0.297), rgba(26, 26, 26, 0.39));
                }

            .faq summary {
                cursor: pointer;
                font-weight: 300;
                font-size: 1.08rem;
                padding-right: 32px;
                list-style: none;
                outline: none;
                position: relative;
                color: #fff !important;
                text-shadow: var(--shadow-ink-strong);
            }

                /* Chevron indicator */
                .faq summary::after {
                    content: "›";
                    position: absolute;
                    right: 6px;
                    top: 50%;
                    transform: translateY(-50%) rotate(90deg);
                    font-size: 1.4rem;
                    line-height: 1;
                    opacity: .95;
                    transition: transform .2s ease;
                }

            .faq details[open] summary::after {
                transform: translateY(-50%) rotate(270deg);
            }

            /* FAQ body text */
            .faq p {
                margin-top: 10px;
                font-size: 1rem;
                opacity: .98;
            }

        /* ===== VIDEO ===== */
        .video-container {
            width: 100%;
            max-width: 900px;
            margin: 6px auto 0;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 18px 50px rgba(0,0,0,.65);
            border: 1px solid rgba(255,215,0,.35);
        }

            .video-container iframe {
                width: 100%;
                height: 460px;
                border: 0;
            }

        /* ===== ANIMATIONS (retrigger) ===== */
        .reveal {
            opacity: 0;
            transform: translateY(42px);
            transition: opacity .7s ease, transform .7s ease;
        }

            .reveal.show {
                opacity: 1;
                transform: translateY(0);
            }

        .fade-left {
            transform: translateX(-64px);
            opacity: 0;
            transition: all .8s ease;
        }

        .fade-right {
            transform: translateX(64px);
            opacity: 0;
            transition: all .8s ease;
        }

            .fade-left.show, .fade-right.show {
                transform: none;
                opacity: 1;
            }

        /* ===== RESPONSIVE ===== */
        @@media (max-width:1024px) {
            section img {
                width: 48vw;
                height: 38vw;
                max-width: 520px;
                max-height: 420px;
            }
        }

        @@media (max-width:900px) {
            section {
                flex-direction: column !important;
                text-align: center;
                gap: 22px;
            }

                section .content {
                    text-align: center;
                }

                section img {
                    width: 92%;
                    height: 280px;
                }

            .quotes {
                grid-template-columns: 1fr;
            }

            .strip {
                grid-template-columns: repeat(2,1fr);
            }
        }
    </style>
}


