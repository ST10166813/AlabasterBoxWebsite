@{ 
    ViewData["Title"] = "Home Page";
}

@section Styles {
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root{
  --gold:#FFD700; --gold2:#FFB300;
  --ink:#fff; --muted:#d1d1d1;
  --shadow-ink-weak:0 2px 6px rgba(0,0,0,.85);
  --shadow-ink-strong:0 3px 10px rgba(0,0,0,.92), 0 8px 26px rgba(0,0,0,.55);
  --glass:linear-gradient(180deg, rgba(10,10,12,.18), rgba(255,255,255,.06));
}

/* ===== BASE ===== */
html,body{margin:0;padding:0;font-family:'Poppins','Segoe UI',sans-serif;color:#fff;overflow-x:hidden;scroll-behavior:smooth;text-shadow:var(--shadow-ink-weak);}
h1,h2,h3,h4,h5,h6,p,a,li,span,small,label,summary,button,dt,dd,figcaption,.name,.strip .item span,.faq *{color:#fff!important;text-shadow:var(--shadow-ink-weak);}

/* ===== LAYOUT ===== */
section{padding:68px 28px;display:flex;align-items:center;justify-content:center;gap:36px;flex-wrap:wrap;text-align:left;}
section.compact{padding:36px 20px;}
section:nth-of-type(even):not(.compact){flex-direction:row-reverse;}
section img{width:460px;height:360px;object-fit:cover;border-radius:18px;box-shadow:0 10px 34px rgba(0,0,0,.45);}
section .content{max-width:620px;}

/* ===== TITLES ===== */
h1,h2{font-weight:800;text-transform:uppercase;letter-spacing:.8px;background:none!important;-webkit-background-clip:initial;background-clip:initial;color:#fff!important;text-shadow:var(--shadow-ink-strong);margin:0 0 .6rem;}
h2{font-size:clamp(1.6rem,3.6vw,2.2rem);}

.page-title{
  font-size:clamp(2.2rem,4.8vw,3.2rem);
  text-align:center;width:100%;
  max-width:26ch;           
  margin-inline:auto;
  text-wrap:balance;
  line-height:1.15;
}
.page-kicker{
  text-align:center;max-width:70ch;margin:8px auto 0;opacity:.95;
}

/* ===== QUICK INFO (NEW) ===== */
.quick-info {
  display: flex;
  gap: 15px;
  justify-content: center;
  margin-top: 30px;
  flex-wrap: wrap;
}
.info-tag {
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 215, 0, 0.25);
  padding: 14px 22px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  text-align: left;
  box-shadow: 0 10px 25px rgba(0,0,0,0.3);
}
.info-tag i { color: var(--gold); font-size: 1.4rem; }
.info-tag strong { display: block; font-size: 0.7rem; text-transform: uppercase; color: var(--gold); letter-spacing: 1px; margin-bottom: 2px; }
.info-tag span { font-size: 0.95rem; font-weight: 500; }

/* ===== Under-note accents ===== */
.under-note{margin-top:12px;}
.accent{height:10px;display:flex;align-items:center;justify-content:center;gap:8px;margin:8px 0 10px;}
.accent::before,.accent::after{
  content:"";flex:1;height:1px;
  background:linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.35), rgba(255,255,255,0));
}
.accent i{
  display:inline-block;width:10px;height:10px;border-radius:999px;
  background:radial-gradient(circle at 40% 40%, var(--gold), var(--gold2));
  box-shadow:0 0 12px rgba(255,215,0,.35);
}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chips .chip{
  font-size:.85rem;padding:6px 10px;border-radius:999px;
  border:1px solid rgba(255,255,255,.18);background:var(--glass);
  box-shadow:0 6px 16px rgba(0,0,0,.35);opacity:.96;
}

/* ===== Paragraphs ===== */
p{font-size:1.03rem;line-height:1.7;margin:0 0 .8rem;}

/* ===== BUTTON ===== */
.btn{display:inline-block;margin-top:8px;padding:10px 26px;font-weight:600;border-radius:42px;text-decoration:none;color:#111;background:linear-gradient(135deg,var(--gold),var(--gold2));box-shadow:0 8px 22px rgba(0,0,0,.45);transition:transform .2s ease,box-shadow .2s ease,filter .2s ease;}
.btn:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(0,0,0,.55);filter:brightness(1.05);}
.btn-outline { background: rgba(255,255,255,0.05); color: #fff!important; border: 1px solid rgba(255,255,255,0.3); margin-left: 10px; }

/* ===== FAQ ===== */
.faq{width:100%;max-width:900px;}
.faq details{border:1px solid rgba(255,217,0,.212);border-radius:15px;background:linear-gradient(180deg, rgba(8,8,8,.067), rgba(22,22,22,.149));padding:14px 16px;margin-bottom:12px;box-shadow:0 12px 28px rgba(0,0,0,.55);transition:all .2s ease;}
.faq details[open]{border-color:#fff;box-shadow:0 16px 36px rgba(121,121,121,.33);background:linear-gradient(180deg, rgba(162,162,162,.297), rgba(26,26,26,.39));}
.faq summary{cursor:pointer;font-weight:300;font-size:1.08rem;padding-right:32px;list-style:none;outline:none;position:relative;}
.faq summary::after{content:"›";position:absolute;right:6px;top:50%;transform:translateY(-50%) rotate(90deg);font-size:1.4rem;line-height:1;opacity:.95;transition:transform .2s ease;}
.faq details[open] summary::after{transform:translateY(-50%) rotate(270deg);}
.faq p{margin-top:10px;font-size:1rem;opacity:.98;}

/* ===== VIDEO ===== */
.video-container{width:100%;max-width:900px;margin:6px auto 0;border-radius:16px;overflow:hidden;box-shadow:0 18px 50px rgba(0,0,0,.65);border:1px solid rgba(255,215,0,.35);}
.video-container iframe{width:100%;height:460px;border:0;}

/* ===== ANIMATIONS ===== */
.reveal{opacity:0;transform:translateY(42px);transition:opacity .7s ease, transform .7s ease;}
.reveal.show{opacity:1;transform:translateY(0);}
.fade-left{transform:translateX(-64px);opacity:0;transition:all .8s ease;}
.fade-right{transform:translateX(64px);opacity:0;transition:all .8s ease;}
.fade-left.show,.fade-right.show{transform:none;opacity:1;}

/* ===== RESPONSIVE ===== */
@@media (max-width:900px){
  section{flex-direction:column!important;text-align:center;gap:22px;}
  section img{width:92%;height:280px;}
  .quick-info { flex-direction: column; align-items: center; }
  .info-tag { width: 100%; max-width: 320px; }
  .btn-outline { margin-left: 0; margin-top: 10px; }
}
</style>
}

<div class="page-overlay">

  <section class="compact" style="flex-direction:column; text-align:center; min-height: 70vh; justify-content: center;">
    <div class="content reveal">
      <h1 class="page-title">Welcome to Alabaster Box Anointing Ministries</h1>
      <p class="page-kicker">Discover a sacred space of faith, hope, and love. Our ministry exists to uplift and guide you to live out God’s word every day.</p>
      
      <div class="quick-info">
        <div class="info-tag">
          <i class="bi bi-geo-alt-fill"></i>
          <div>
            <strong>Our Location</strong>
            <span>New Germany Primary School</span>
          </div>
        </div>
        <div class="info-tag">
          <i class="bi bi-clock-fill"></i>
          <div>
            <strong>Service Time</strong>
            <span>Sundays @@ 14:30pm</span>
          </div>
        </div>
      </div>

      <div style="margin-top: 35px;">
        <a href="/Donate" class="btn">Support Our Ministry</a>
        <a href="/Events" class="btn btn-outline">View Upcoming Services</a>
      </div>
    </div>
  </section>

  <section>
    <img src="~/images/imgthree.jpg" alt="About Alabaster Box" class="fade-left reveal">
    <div class="content fade-right reveal">
      <h2>About Alabaster Box</h2>
      <p>Alabaster Box Anointing Ministries is built on compassion and purpose. We provide opportunities for worship, teaching, outreach, and personal growth through the Word of God. Our heart is to serve and equip every believer to walk boldly in their calling.</p>
      <a href="/AboutUs" class="btn">Learn More</a>
    </div>
  </section>

  <section>
    <img src="~/images/imgtwo.jpeg" alt="Our Mission" class="fade-right reveal">
    <div class="content fade-left reveal">
      <h2>Our Mission</h2>
      <p>To share the gospel of Christ through worship, discipleship, and acts of love, bringing hope to every heart. Every service, outreach, and prayer moment aims to glorify God and uplift His people.</p>
      <div class="under-note">
        <div class="accent"><i></i></div>
        <div class="chips">
          <span class="chip">Worship</span>
          <span class="chip">Discipleship</span>
          <span class="chip">Love in Action</span>
        </div>
      </div>
    </div>
  </section>

  <section>
    <img src="~/images/imgone.jpg" alt="Our Vision" class="fade-left reveal">
    <div class="content fade-right reveal">
      <h2>Our Vision</h2>
      <p>We envision a faith-filled community where lives are transformed through the power of God’s Word, empowered to impact families, cities, and nations for His glory.</p>
      <div class="under-note">
        <div class="accent"><i></i></div>
        <div class="chips">
          <span class="chip">Transformed Lives</span>
          <span class="chip">Strong Families</span>
          <span class="chip">Global Impact</span>
        </div>
      </div>
    </div>
  </section>

  <section>
    <img src="~/images/imgfour.jpg" alt="Community Outreach" class="fade-right reveal">
    <div class="content fade-left reveal">
      <h2>Community & Outreach</h2>
      <p>Faith in action — that’s our call. Through feeding programs, youth mentorship, and acts of kindness, we live out God’s love daily. Be part of the change that brings hope to our communities.</p>
      <a href="/Events/Volunteer" class="btn">Join Our Outreach</a>
    </div>
  </section>

  <section class="compact" style="flex-direction:column; text-align:center;">
    <div class="content reveal">
      <h2>Watch Our Latest Sermon</h2>
      <p>Can’t make it in person? Connect with us online via our YouTube channel to watch live and archived sermons.</p>
    </div>
    <div class="video-container reveal">
      <iframe title="Latest sermon video" src="https://www.youtube.com/embed/UCFqkqWkSvJ_hm0m2whwGZWQ?rel=0" allowfullscreen></iframe>
    </div>
  </section>

  <section class="compact" style="flex-direction:column; text-align:center;">
    <div class="content reveal" style="max-width:900px;">
      <h2>Testimony Highlights</h2>
      <p>Stories of healing, restoration, and hope from our community.</p>
    </div>
    <div class="quotes reveal">
      <div class="quote">
        <p>“I walked in burdened and left renewed — God met me in worship.”</p>
        <div class="name">— N.D.</div>
      </div>
      <div class="quote">
        <p>“Our family experienced breakthrough after the prayer team stood with us.”</p>
        <div class="name">— P.M.</div>
      </div>
      <div class="quote">
        <p>“Serving at the outreach reminded me how powerful love in action is.”</p>
        <div class="name">— S.K.</div>
      </div>
    </div>
    <a href="/Testimonies" class="btn" style="margin-top:12px;">Read More Testimonies</a>
  </section>

  <section class="compact" style="flex-direction:column; text-align:left;">
    <div class="content reveal" style="max-width:900px; margin:0 auto;">
      <h2 style="text-align:center;">Frequently Asked Questions</h2>
      <div class="faq">
        <details class="reveal">
          <summary>Where and what time are services?</summary>
          <p>We gather every <strong>Sunday at 14:30pm</strong> at <strong>New Germany Primary School</strong>. Everyone is welcome!</p>
        </details>
        <details class="reveal">
          <summary>How do I volunteer?</summary>
          <p>Head to the Volunteer page, choose an event, and submit the quick form.</p>
        </details>
        <details class="reveal">
          <summary>How can I give?</summary>
          <p>Use the Donate page for EFT details or info on physical donations. Thank you!</p>
        </details>
      </div>
    </div>
  </section>
</div>

@section Scripts {
<script>
  const reveals = document.querySelectorAll('.reveal, .fade-left, .fade-right');
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting){ entry.target.classList.add('show'); }
      else{ entry.target.classList.remove('show'); }
    });
  },{ threshold: 0.18 });
  reveals.forEach(el=>io.observe(el));
</script>
}