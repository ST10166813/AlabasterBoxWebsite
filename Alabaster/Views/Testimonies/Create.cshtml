@model Alabaster.Models.Testimony
@{
    ViewBag.Title = "Share Your Testimony";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

@section Styles {
    @* include shared styles *@
    @await Html.PartialAsync("_TestimonyShared")

    <style>
        /* Create page specific styles (kept local) */
        .hero-title {
            text-align: center;
            padding: clamp(100px, 12vh, 180px) 20px 60px;
            position: relative;
            z-index: 1;
        }

            .hero-title h1 {
                font-size: clamp(2.4rem, 4vw, 3.6rem);
                font-weight: 900;
                text-transform: uppercase;
                letter-spacing: 2px;
                color: #fff;
                text-shadow: 0 2px 6px rgba(0,0,0,.55);
            }

            .hero-title p {
                font-size: 1.1rem;
                color: #e4e4ec;
                opacity: .9;
                max-width: 700px;
                margin: 10px auto 0;
            }

        .page-wrap {
            position: relative;
            padding: clamp(60px, 6vh, 100px) 18px 100px;
        }

        .testimony-card {
            width: min(1280px, 94vw);
            margin: 0 auto;
            padding: clamp(18px, 2.2vw, 28px);
            border-radius: 22px;
            border: 1px solid var(--glass-brd);
            background: linear-gradient(180deg, var(--glass-1), var(--glass-2));
            backdrop-filter: blur(14px) saturate(140%);
            box-shadow: var(--shadow);
        }

        h2.page-title {
            margin: 0;
            text-align: center;
            font-size: clamp(1.6rem, 2.2vw, 2.1rem);
            font-weight: 900;
            background: linear-gradient(90deg, var(--gold), #ffffff 45%, #c6c6c6);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-shadow: 0 0 18px rgba(255,255,255,.18);
        }

        .subtitle {
            text-align: center;
            margin-top: 6px;
            color: #dcdce5;
            opacity: .9;
            font-size: .98rem;
        }

        .hr {
            height: 1px;
            margin: 18px 0 14px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.18), transparent);
            border: 0;
        }

        .form-grid {
            display: grid;
            gap: 14px;
            grid-template-columns: 1fr;
        }

        @@media (min-width: 860px) {
            .form-grid {
                grid-template-columns: 1fr 1fr;
            }

            .col-span-2 {
                grid-column: 1 / -1;
            }
        }

        label {
            font-weight: 700;
            font-size: .95rem;
            color: #efefef;
        }

        /* Additional tweaks for file presentation (kept local to page) */
        .meta-note {
            text-align: center;
            font-size: .9rem;
            color: var(--muted);
        }

        /* Keep only small responsive changes */
        @@media (max-width:860px) {
            .testimony-card {
                padding: 18px;
            }
        }
    </style>
}

<!-- ===== Title Section ===== -->
<section class="hero-title">
    <h1>Share Your Testimony</h1>
    <p>We believe every story carries hope and faith — share yours and let it inspire others in their journey.</p>
</section>

<!-- ===== Form Section ===== -->
<div class="page-wrap">
    <div class="testimony-card">
        <h2 class="page-title">Your Testimony Details</h2>
        <p class="subtitle">Please fill in the information below to submit your testimony.</p>
        <hr class="hr" />

        <form asp-controller="Testimonies" asp-action="Create" method="post" enctype="multipart/form-data">
            <div class="form-grid">
                <!-- Title -->
                <div class="col-span-2">
                    <label for="testimonyTitle">Title</label>
                    <div class="input-wrap">
                        <i class="bi bi-type input-icon"></i>
                        <input id="testimonyTitle" name="Title" type="text" class="form-control" required placeholder="Give your testimony a title" />
                    </div>
                </div>

                <!-- Name -->
                <div class="col-span-2">
                    <label for="testimonyName">Your Name</label>
                    <div class="input-wrap">
                        <i class="bi bi-person input-icon"></i>
                        <input id="testimonyName" name="CreatedBy" type="text" class="form-control" required placeholder="Enter your name" />
                    </div>
                </div>

                <!-- Image Upload -->
                <div class="col-span-2">
                    <label for="testimonyImageUpload">Upload Image (optional)</label>
                    <div class="input-wrap" style="position:relative;">
                        <i class="bi bi-image input-icon"></i>

                        <input id="testimonyImageUpload" name="ImageUpload" type="file" accept="image/*" class="form-control file-input" />
                        <div class="file-row" aria-hidden="true">
                            <button type="button" class="file-btn" aria-hidden="true">Choose Image</button>
                            <span id="testimonyFileName" class="file-name">No file chosen</span>
                        </div>
                    </div>
                </div>

                <!-- Description -->
                <div class="col-span-2">
                    <label for="testimonyDescription">Your Testimony</label>
                    <div class="input-wrap">
                        <i class="bi bi-chat-quote input-icon"></i>
                        <textarea id="testimonyDescription" name="Description" class="form-control" required placeholder="Share what the Lord has done for you"></textarea>
                    </div>
                </div>
            </div>

            <div class="actions" style="margin-top:14px; display:grid; gap:12px;">
                <button type="submit" class="btn-primary">
                    <i class="bi bi-send-fill"></i> Submit Testimony
                </button>

                <div class="hr-bottom" style="height:1px; background: linear-gradient(90deg, transparent, rgba(255,255,255,.18), transparent); margin:8px 0;"></div>

                <a class="btn-alt" href="@Url.Action("Index", "Testimonies")">
                    <i class="bi bi-journal-text"></i> View All Testimonies
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // file input UI wiring (page-specific)
        (function () {
          const realInput = document.getElementById('testimonyImageUpload');
          const fakeBtn = document.querySelector('.file-btn');
          const fileName = document.getElementById('testimonyFileName');

          fakeBtn?.addEventListener('click', () => realInput?.click());
          realInput?.addEventListener('change', () => {
            const name = realInput.files && realInput.files[0] ? realInput.files[0].name : 'No file chosen';
            if (fileName) fileName.textContent = name;
          });
        })();
    </script>
}
