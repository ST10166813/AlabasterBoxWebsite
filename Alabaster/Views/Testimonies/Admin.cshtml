@model IEnumerable<Alabaster.Models.Testimony>
@{
    ViewBag.Title = "Pending Testimonies";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Safe model list so view won't crash if Model is null
    var items = (Model ?? Enumerable.Empty<Alabaster.Models.Testimony>()).ToList();
}

@section Styles {
    <style>
        :root {
            --gold: #FFD700;
            --ink: #fff;
            --muted: #cfcfd6;
            --glass-1: rgba(51,51,51,.65);
            --glass-2: rgba(103,103,106,.45);
            --glass-brd: rgba(84,83,83,.41);
            --shadow: 0 25px 70px rgba(0,0,0,.55);
        }

        /* Base & wallpaper */
        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Poppins','Segoe UI',sans-serif;
            color: var(--ink);
            background: transparent; /* wallpaper provided by pseudo-element */
            overflow-x: hidden;
            position: relative;
        }

            /* wallpaper layer (Razor friendly) */
            body::before {
                content: "";
                position: fixed;
                inset: 0;
                z-index: -3;
                pointer-events: none;
                background-image: url('@Url.Content("~/images/4.jpg")');
                background-position: center -10%;
                background-size: cover;
                background-repeat: no-repeat;
                background-attachment: fixed;
                filter: saturate(1.02) brightness(0.86);
            }

            /* subtle dim overlay so text is readable */
            body::after {
                content: "";
                position: fixed;
                inset: 0;
                z-index: -2;
                pointer-events: none;
                background: rgba(0,0,0,0.28);
            }

        /* Ensure header/nav sits above wallpaper */
        header, nav, .page-content {
            position: relative;
            z-index: 5;
        }

        /* Page container */
        .page-content {
            position: relative;
            z-index: 10;
            max-width: 1400px;
            margin: 3.5rem auto;
            padding: clamp(1rem, 3vw, 2.4rem);
            box-sizing: border-box;
        }

        /* Heading */
        .page-head {
            text-align: center;
            margin-bottom: 1.6rem;
        }

            .page-head h1 {
                font-size: clamp(1.8rem, 3.6vw, 2.6rem);
                font-weight: 900;
                margin: 0 0 .25rem 0;
                color: #fff;
                text-shadow: 0 2px 6px rgba(0,0,0,.55);
            }

            .page-head .tagline {
                color: rgba(255,255,255,.92);
                font-size: .95rem;
            }

        /* Section title box */
        .section-title {
            display: inline-block;
            padding: .7rem 1.1rem;
            border-radius: 14px;
            background: linear-gradient(180deg, rgba(255,215,0,.12), rgba(255,255,255,.02));
            border: 1px solid rgba(240,240,235,.6);
            color: var(--gold);
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .8px;
        }

        /* Glass panel + table */
        .glass-panel {
            background: linear-gradient(180deg, var(--glass-1), var(--glass-2));
            border: 1px solid var(--glass-brd);
            border-radius: 18px;
            padding: 1rem;
            box-shadow: var(--shadow);
            backdrop-filter: blur(10px);
            margin-top: 1rem;
        }

        .table-wrap {
            overflow: auto;
            border-radius: 12px;
            background: rgba(255,255,255,.02);
            border: 1px solid rgba(255,255,255,.06);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 900px;
            color: var(--ink);
            font-size: .98rem;
        }

        thead th {
            background: linear-gradient(180deg, rgba(213,188,43,.9), rgba(169,161,120,.54));
            color: #111;
            padding: .9rem;
            position: sticky;
            top: 0;
            z-index: 1;
        }

        tbody td {
            padding: .75rem .9rem;
            border-bottom: 1px solid rgba(255,255,255,.06);
        }

        /* row hover */
        tbody tr {
            transition: background .18s ease, transform .18s ease;
        }

            tbody tr:hover {
                background: rgba(255,255,255,.03);
                transform: translateY(-2px);
            }

        /* empty state */
        .empty-wrap {
            margin-top: 1.8rem;
            text-align: center;
            color: rgba(255,255,255,.95);
        }

        /* subtle sparkle elements (animated by JS via inline styles + transitions) */
        .sparkle {
            position: fixed;
            width: 3px;
            height: 3px;
            background: rgba(255,215,0,0.9);
            border-radius: 50%;
            pointer-events: none;
            z-index: 1;
            opacity: 0;
            transform: translateY(0) scale(.6);
            transition: transform 900ms ease, opacity 900ms ease;
        }
    </style>
}

@section Scripts {
    <script>
        // simple sparkle via JS transitions (no keyframes)
        (function(){
          function createSparkle(){
            const s = document.createElement('div');
            s.className = 'sparkle';
            const size = Math.random()*3 + 2;
            s.style.width = s.style.height = size + 'px';
            s.style.left = Math.random()*window.innerWidth + 'px';
            s.style.top = Math.random()*window.innerHeight + 'px';
            document.body.appendChild(s);
            // force reflow to start transition
            void s.offsetWidth;
            s.style.opacity = '1';
            s.style.transform = 'translateY(-30px) scale(1)';
            const life = 3000 + Math.random()*3000;
            setTimeout(() => {
              s.style.opacity = '0';
              s.style.transform = 'translateY(-60px) scale(.6)';
              setTimeout(()=> s.remove(), 900);
            }, life);
          }
          setInterval(createSparkle, 700);
        })();
    </script>
}

<div class="page-content">
    <header class="page-head" aria-labelledby="pt-head">
        <h1 id="pt-head">Pending Testimonies</h1>
        <div class="tagline">Admin • Review • Approval • Community</div>
        <p class="head-desc">Review submitted testimonies, approve to publish, or reject with care.</p>
    </header>

    @if (!items.Any())
    {
        <section class="empty-wrap" aria-live="polite">
            <h2 class="section-title">Pending Testimonies</h2>
            <p>There are no testimonies awaiting review right now. Check back soon.</p>
        </section>
    }
    else
    {
        <h2 class="section-title">Admin Review Queue</h2>

        <div class="glass-panel" role="region" aria-label="Pending testimonies table">
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Description</th>
                            <th>Created By</th>
                            <th>Submitted At</th>
                            <th>Image</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td>@(item?.Title ?? "(No title)")</td>
                                <td>@(item?.Description ?? "")</td>
                                <td>@(string.IsNullOrWhiteSpace(item?.CreatedBy) ? "Anonymous" : item.CreatedBy)</td>
                                <td>@(item?.CreatedAt ?? "")</td>
                                <td>
                                    <span class="table-img">
                                        <img title="image"
                                             src="@(string.IsNullOrWhiteSpace(item?.ImageBase64) ? Url.Content("~/Images/Default%20image.png") : $"data:image/jpeg;base64,{item.ImageBase64}")"
                                             alt="@(string.IsNullOrEmpty(item?.Title) ? "Testimony image" : "Image for " + item.Title)"
                                             width="96" height="72" loading="lazy" />
                                    </span>
                                </td>
                                <td>
                                    <div class="actions">
                                        <form asp-action="Approve" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-approve">Approve</button>
                                        </form>
                                        <form asp-action="Reject" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-reject">Reject</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
