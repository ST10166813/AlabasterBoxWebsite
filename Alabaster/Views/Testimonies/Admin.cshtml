@model IEnumerable<Alabaster.Models.Testimony>
@{
    ViewBag.Title = "Pending Testimonies";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    @* include shared styles *@
    @await Html.PartialAsync("_TestimonyShared")

    <style>
        /* Admin-specific styles (kept local) */
        .page-content {
            padding: clamp(2.5rem, 6vw, 5rem) 1.25rem clamp(3rem, 7vw, 5rem);
            color: var(--ink);
        }

        .page-head {
            display: grid;
            gap: .6rem;
            justify-items: center;
            text-align: center;
            margin-bottom: clamp(1.6rem, 3.2vw, 2.2rem);
        }

            .page-head h1 {
                font-size: clamp(2.4rem, 5.6vw, 4.4rem);
                font-weight: 900;
                line-height: 1.12;
                padding-bottom: 6px;
                letter-spacing: .3px;
                text-transform: uppercase;
                color: #fff;
                text-shadow: 0 2px 6px rgba(0, 0, 0, 0.55);
            }

        .tagline {
            font-size: clamp(.95rem, 1.6vw, 1.15rem);
            letter-spacing: .6px;
            opacity: .995;
            text-transform: uppercase;
            color: var(--ink);
        }

        .section-title {
            font-size: clamp(1.6rem, 2.6vw, 2.2rem);
            font-weight: 900;
            text-align: center;
            margin: 1.8rem auto 2.2rem;
            padding: .9rem 1.6rem;
            text-transform: uppercase;
            background: linear-gradient(180deg, rgba(255, 215, 0, 0.15), rgba(255, 255, 255, 0.05));
            border: 1px solid rgba(240,240,235,0.6);
            border-radius: 18px;
            box-shadow: 0 0 25px rgba(255, 215, 0, 0.35), 0 0 55px rgba(255, 215, 0, 0.25);
            backdrop-filter: blur(10px);
            background-image: linear-gradient(90deg, var(--ink), #ffffff 45%, var(--ink));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            background-size: 200% auto;
            animation: sectionShimmer 6s linear infinite;
            letter-spacing: 1px;
        }

        @@keyframes sectionShimmer {
            0% {
                background-position: 0% 50%
            }

            100% {
                background-position: 200% 50%
            }
        }

        .glass-panel {
            background: linear-gradient(180deg, rgba(51,51,51,0.65), rgba(103,103,106,0.45));
            border: 1px solid rgba(84,83,83,0.41);
            border-radius: 22px;
            box-shadow: var(--shadow);
            padding: clamp(1rem, 2.2vw, 1.75rem);
            backdrop-filter: blur(10px);
        }

        .table-wrap {
            overflow: auto;
            border-radius: 16px;
            background: rgba(255,255,255,.02);
            border: 1px solid rgba(255,255,255,.08);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 900px;
            color: var(--ink);
        }

        thead th {
            font-weight: 900;
            text-transform: uppercase;
            font-size: .95rem;
            letter-spacing: .06em;
            background: linear-gradient(180deg, rgba(213, 188, 43, 0.9), rgba(169, 161, 120, 0.536));
            color: #111;
            border-bottom: 1px solid rgba(255,255,255,.10);
            padding: 1rem .9rem;
            position: sticky;
            top: 0;
            z-index: 1;
            backdrop-filter: blur(6px);
        }

        tbody td {
            padding: .9rem .9rem;
            font-size: .98rem;
            vertical-align: top;
            border-bottom: 1px solid rgba(255,255,255,.06);
        }

        tbody tr:hover {
            background: rgba(255,255,255,.03);
        }

        .table-img {
            display: inline-block;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,.10);
            box-shadow: 0 8px 24px rgba(0,0,0,.35);
        }

        .actions {
            display: flex;
            gap: .6rem;
            flex-wrap: wrap;
        }

        .btn-approve {
            color: #0b1b13;
            background: linear-gradient(180deg,rgba(0, 255, 128, 0.281),rgba(0, 200, 83, 0.314));
            box-shadow: 0 10px 24px rgba(0,255,127,.25);
        }

            .btn-approve:hover {
                box-shadow: 0 16px 36px rgba(0, 255, 128, 0.093);
            }

        .btn-reject {
            color: #fff;
            background: linear-gradient(180deg,rgba(255, 68, 68, 0.342),rgba(204, 0, 0, 0.222));
            box-shadow: 0 10px 24px rgba(255,68,68,.25);
        }

            .btn-reject:hover {
                box-shadow: 0 16px 36px rgba(255,68,68,.35);
            }

        .empty-wrap {
            margin-top: 2.2rem;
            display: grid;
            gap: .8rem;
            justify-items: center;
            text-align: center;
        }

            .empty-wrap .section-title {
                margin: 0 auto .6rem;
            }

            .empty-wrap p {
                color: rgba(255,255,255,.9);
                max-width: 760px;
                line-height: 1.65;
                font-size: 1.02rem;
                margin: 0 auto;
            }

        /* small responsive tweak */
        @@media (max-width:768px) {
            .btn {
                padding: .55rem .9rem;
                font-size: .9rem;
            }
        }
    </style>
}

@section Scripts {
    <script>
        // sparkles (admin uses them)
        (function createSparkle() {
          function spawn() {
            const s = document.createElement('div');
            s.className = 'sparkle';
            s.style.left = Math.random() * window.innerWidth + 'px';
            s.style.top = Math.random() * window.innerHeight + 'px';
            s.style.width = s.style.height = (Math.random() * 3 + 2) + 'px';
            s.style.animationDuration = (5 + Math.random() * 5) + 's';
            document.body.appendChild(s);
            setTimeout(() => s.remove(), 10000);
          }
          setInterval(spawn, 300);
        })();
    </script>
}

<div class="page-content">
    <header class="page-head" aria-labelledby="pt-head">
        <h1 id="pt-head">PENDING TESTIMONIES</h1>
        <div class="tagline">Admin • Review • Approval • Community</div>
        <p class="head-desc">Review submitted testimonies, approve to publish, or reject with care. Your decisions shape the stories we share.</p>
    </header>

    @if (!Model.Any())
    {
        <section class="empty-wrap" aria-live="polite">
            <h2 class="section-title">Pending Testimonies</h2>
            <p>There are no testimonies awaiting review right now. Check back soon — new voices are on the way.</p>
        </section>
    }
    else
    {
        <h2 class="section-title">Admin Review Queue</h2>
        <div class="glass-panel">
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Description</th>
                            <th>Created By</th>
                            <th>Submitted At</th>
                            <th>Image</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Title</td>
                                <td>@item.Description</td>
                                <td>@(string.IsNullOrEmpty(item.CreatedBy) ? "Anonymous" : item.CreatedBy)</td>
                                <td>@item.CreatedAt</td>
                                <td>
                                    <span class="table-img">
                                        <img src="@(string.IsNullOrEmpty(item.ImageBase64) ? Url.Content("~/Images/Default%20image.png") : $"data:image/jpeg;base64,{item.ImageBase64}")" width="96" height="72" loading="lazy" />
                                    </span>
                                </td>
                                <td>
                                    <div class="actions">
                                        <form asp-action="Approve" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-approve">Approve</button>
                                        </form>
                                        <form asp-action="Reject" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-reject">Reject</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
