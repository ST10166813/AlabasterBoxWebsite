@model IEnumerable<Alabaster.Models.Testimony>
@{
    ViewBag.Title = "Pending Testimonies";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        :root {
            --gold: #FFD700;
            --ink: #fff;
            --muted: #cfcfd6;
            --glass-1: rgba(51, 51, 51, 0.65);
            --glass-2: rgba(103, 103, 106, 0.45);
            --glass-brd: rgba(84, 83, 83, 0.41);
            --shadow: 0 25px 70px rgba(0,0,0,.55);
        }

        /* ==== Page background (Razor-friendly) ==== */
        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Poppins','Segoe UI',sans-serif;
            color: var(--ink);
            background: #08090c; /* fallback */
            overflow-x: hidden;
            position: relative;
        }

            /* background image layer (Razor Url.Content resolves "~") */
            body::before {
                content: "";
                position: fixed;
                inset: 0;
                z-index: -3;
                background-image: url('@Url.Content("~/images/4.jpg")');
                background-position: center -10%;
                background-size: cover;
                background-repeat: no-repeat;
                background-attachment: fixed;
                filter: saturate(1.02) brightness(0.86);
            }

            /* subtle global tint so text is legible */
            body::after {
                content: "";
                position: fixed;
                inset: 0;
                z-index: -2;
                background: rgba(0,0,0,0.22);
                pointer-events: none;
            }

        /* Container */
        .page-content {
            position: relative;
            z-index: 1;
            max-width: 1400px;
            margin-inline: auto;
            padding: clamp(2.5rem, 6vw, 5rem) 1.25rem clamp(3rem, 7vw, 5rem);
            box-sizing: border-box;
        }

        /* Head */
        .page-head {
            display: grid;
            gap: .6rem;
            justify-items: center;
            text-align: center;
            margin-bottom: clamp(1.6rem, 3.2vw, 2.2rem);
        }

            .page-head h1 {
                font-size: clamp(2.4rem, 5.6vw, 4.4rem);
                font-weight: 900;
                line-height: 1.12;
                letter-spacing: .3px;
                text-transform: uppercase;
                color: #fff;
                text-shadow: 0 2px 6px rgba(0,0,0,.55);
                margin: 0;
            }

        .tagline {
            font-size: clamp(.95rem, 1.6vw, 1.15rem);
            letter-spacing: .6px;
            text-transform: uppercase;
            color: var(--ink);
            opacity: .95;
        }

        .head-desc {
            max-width: 920px;
            opacity: .92;
            text-align: center;
            font-size: clamp(1rem, 1.4vw, 1.12rem);
            margin: .6rem auto 0;
        }

        /* Section title (static gradient text, no animation) */
        .section-title {
            font-size: clamp(1.6rem, 2.6vw, 2.2rem);
            font-weight: 900;
            text-align: center;
            margin: 1.8rem auto 2.2rem;
            padding: .9rem 1.6rem;
            text-transform: uppercase;
            background: linear-gradient(90deg, #ffffff 20%, var(--gold) 50%, #ffffff 80%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            background-size: 200% auto;
            border-radius: 18px;
        }

        /* Glass panel + table */
        .glass-panel {
            background: linear-gradient(180deg, var(--glass-1), var(--glass-2));
            border: 1px solid var(--glass-brd);
            border-radius: 22px;
            box-shadow: var(--shadow);
            padding: clamp(1rem, 2.2vw, 1.75rem);
            backdrop-filter: blur(10px);
            transform: translateY(12px);
            opacity: 0;
            transition: transform 620ms cubic-bezier(.16,.84,.28,1), opacity 620ms ease;
        }

            .glass-panel.visible {
                transform: translateY(0);
                opacity: 1;
            }

        .table-wrap {
            overflow: auto;
            border-radius: 16px;
            background: rgba(255,255,255,.02);
            border: 1px solid rgba(255,255,255,.08);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 900px;
            color: var(--ink);
        }

        thead th {
            font-weight: 900;
            text-transform: uppercase;
            font-size: .95rem;
            letter-spacing: .06em;
            background: linear-gradient(180deg, rgba(213,188,43,0.9), rgba(169,161,120,0.536));
            color: #111;
            padding: 1rem .9rem;
            position: sticky;
            top: 0;
            z-index: 1;
            backdrop-filter: blur(6px);
            border-bottom: 1px solid rgba(255,255,255,.10);
        }

        tbody td {
            padding: .9rem .9rem;
            font-size: .98rem;
            vertical-align: top;
            border-bottom: 1px solid rgba(255,255,255,.06);
        }

        tbody tr {
            transition: transform .18s ease, background .18s ease, box-shadow .18s ease;
        }

            tbody tr:hover {
                background: rgba(255,255,255,.03);
                transform: translateY(-2px);
                box-shadow: 0 10px 28px rgba(0,0,0,0.35);
            }

        /* images */
        .table-img {
            display: inline-block;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,.10);
            box-shadow: 0 8px 24px rgba(0,0,0,.35);
        }

            .table-img img {
                display: block;
                width: 100%;
                height: auto;
            }

        /* actions */
        .actions {
            display: flex;
            gap: .6rem;
            flex-wrap: wrap;
        }

        .btn {
            padding: .65rem 1.1rem;
            border: none;
            border-radius: 12px;
            font-weight: 800;
            font-size: .95rem;
            cursor: pointer;
            transition: transform .15s ease, box-shadow .2s ease;
            border: 1px solid rgba(255,255,255,.08);
        }

            .btn:active {
                transform: translateY(1px) scale(.99);
            }

        .btn-approve {
            color: #0b1b13;
            background: linear-gradient(180deg, rgba(0,255,128,0.28), rgba(0,200,83,0.31));
            box-shadow: 0 10px 24px rgba(0,255,127,0.25);
        }

        .btn-reject {
            color: #fff;
            background: linear-gradient(180deg, rgba(255,68,68,0.34), rgba(204,0,0,0.22));
            box-shadow: 0 10px 24px rgba(255,68,68,0.25);
        }

        /* empty state */
        .empty-wrap {
            margin-top: 2.2rem;
            display: grid;
            gap: .8rem;
            justify-items: center;
            text-align: center;
        }

            .empty-wrap p {
                color: rgba(255,255,255,.9);
                max-width: 760px;
                line-height: 1.65;
                font-size: 1.02rem;
                margin: 0 auto;
            }

        /* subtle sparkle (no CSS keyframes) */
        .sparkle {
            position: fixed;
            width: 3px;
            height: 3px;
            background: rgba(255,215,0,0.9);
            border-radius: 50%;
            pointer-events: none;
            z-index: 0;
            opacity: 0;
            transform: translateY(0) scale(.6);
            transition: transform 900ms ease, opacity 900ms ease;
            filter: blur(0.6px);
        }

        /* helpers */
        .hidden-visually {
            position: absolute !important;
            height: 1px;
            width: 1px;
            overflow: hidden;
            clip: rect(1px,1px,1px,1px);
            white-space: nowrap;
        }

        .container-pad {
            padding-inline: clamp(12px, 4vw, 36px);
        }
    </style>
}

@section Scripts {
    <script>
        // Reveal the panel (no keyframes)
        (function(){
            const panel = document.querySelector('.glass-panel');
            if (!panel) return;
            const obs = new IntersectionObserver(entries => {
                entries.forEach(e => {
                    if (e.isIntersecting) {
                        e.target.classList.add('visible');
                        obs.unobserve(e.target);
                    }
                });
            }, { threshold: 0.12 });
            obs.observe(panel);
        })();

        // Sparkles via JS using transitions (no keyframes)
        (function () {
            function createSparkle() {
                const s = document.createElement('div');
                s.className = 'sparkle';
                const size = Math.random() * 3 + 2;
                s.style.width = s.style.height = size + 'px';
                s.style.left = Math.random() * window.innerWidth + 'px';
                s.style.top = Math.random() * window.innerHeight + 'px';
                document.body.appendChild(s);
                // force reflow
                void s.offsetWidth;
                s.style.opacity = '1';
                s.style.transform = 'translateY(-30px) scale(1)';
                const lifetime = 3000 + Math.random() * 4000;
                setTimeout(() => {
                    s.style.opacity = '0';
                    s.style.transform = 'translateY(-60px) scale(.6)';
                    setTimeout(() => s.remove(), 900);
                }, lifetime);
            }
            // gentle cadence
            setInterval(createSparkle, 900);
        })();
    </script>
}

<div class="page-content">
    <!-- Header -->
    <header class="page-head" aria-labelledby="pt-head">
        <h1 id="pt-head">PENDING TESTIMONIES</h1>
        <div class="tagline">Admin • Review • Approval • Community</div>
        <p class="head-desc">Review submitted testimonies, approve to publish, or reject with care. Your decisions shape the stories we share.</p>
    </header>

    @if (!Model.Any())
    {
        <section class="empty-wrap" aria-live="polite">
            <h2 class="section-title">Pending Testimonies</h2>
            <p>There are no testimonies awaiting review right now. Check back soon — new voices are on the way.</p>
        </section>
    }
    else
    {
        <h2 class="section-title">Admin Review Queue</h2>

        <div class="glass-panel">
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Description</th>
                            <th>Created By</th>
                            <th>Submitted At</th>
                            <th>Image</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Title</td>
                                <td>@item.Description</td>
                                <td>@(string.IsNullOrEmpty(item.CreatedBy) ? "Anonymous" : item.CreatedBy)</td>
                                <td>@item.CreatedAt</td>
                                <td>
                                    <span class="table-img" style="width:96px;height:72px;display:inline-block;">
                                        <img title="image"
                                             src="@(string.IsNullOrEmpty(item.ImageBase64) ? Url.Content("~/Images/Default%20image.png") : $"data:image/jpeg;base64,{item.ImageBase64}")"
                                             alt="@(string.IsNullOrEmpty(item.Title) ? "Testimony image" : "Image for " + item.Title)"
                                             width="96" height="72" loading="lazy" />
                                    </span>
                                </td>
                                <td>
                                    <div class="actions">
                                        <form asp-action="Approve" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-approve">Approve</button>
                                        </form>
                                        <form asp-action="Reject" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-reject">Reject</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
