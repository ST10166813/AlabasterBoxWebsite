@model IEnumerable<Alabaster.Models.Testimony>
@{
    ViewBag.Title = "Testimonies";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var testimonies = (Model ?? Enumerable.Empty<Alabaster.Models.Testimony>())
                      .Where(x => x != null)
                      .OrderByDescending(t => t?.CreatedAt ?? "")
                      .ToList();
}

@section Styles {
    <style>
        :root {
            --gold: #FFD700;
            --ink: #fff;
            --muted: #cfcfd6;
            --glass-brd: rgba(255,255,255,.15);
            --shadow: 0 25px 70px rgba(0,0,0,.55);
        }

        /* REMOVED: html, body, and body::before overrides. 
           This allows the Layout's orange theme and 1.jpg to show.
        */

        /* page container */
        .page-content {
            position: relative;
            z-index: 10;
            max-width: 1400px;
            margin: 0 auto;
            /* Extra top padding so it doesn't hide under the Nav Bar */
            padding: 120px 1.5rem 60px; 
        }

        /* CTA Button Styling */
        .hero-cta {
            display: inline-block;
            margin: 20px 0;
            padding: 0.8rem 2rem;
            font-weight: 800;
            font-size: 1rem;
            letter-spacing: .5px;
            border-radius: 999px;
            text-decoration: none;
            background: linear-gradient(135deg, #FF7F00, #FFD700);
            color: #111;
            border: 1px solid rgba(255,255,255,0.3);
            box-shadow: 0 10px 20px rgba(0,0,0,0.3);
            transition: all .3s ease;
        }

        .hero-cta:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(255,127,0,0.4);
            color: #000;
        }

        .page-head {
            text-align: center;
            margin-bottom: 2rem;
        }

        .page-head h1 {
            font-size: clamp(2.5rem, 5vw, 4rem);
            font-weight: 900;
            margin: 0;
            color: #fff;
            text-shadow: 0 2px 10px rgba(0,0,0,0.5);
        }

        .section-title {
            display: block;
            text-align: center;
            margin: 40px 0 20px;
            color: var(--gold);
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .testimony-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2rem;
        }
.testimony-card {
    background: rgba(45, 20, 5, 0.6); 
    border: 1px solid rgba(255, 215, 0, 0.2);
    border-radius: 24px;
    padding: 2.5rem 1.5rem; /* More padding on top/bottom */
    text-align: center;
    backdrop-filter: blur(10px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    
    /* Stack content vertically */
    display: flex;
    flex-direction: column;
    align-items: center; 
}

/* Make sure the text looks clean under the square */
.testimony-card p {
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 1rem;
    color: #f1f1f1;
    max-width: 90%; /* Keeps text from hitting the edges */
}

        .testimony-card.show {
            opacity: 1;
            transform: translateY(0);
        }
.testimony-card img {
    /* Create a perfect square */
    width: 250px; 
    height: 250px;
    
    /* This prevents the squishing/stretching */
    object-fit: cover; 
    object-position: center;
    
    /* Visual styling */
    border-radius: 15px; /* Rounded corners */
    margin: 0 auto 1.5rem; /* Center horizontally and add bottom spacing */
    display: block;
    border: 2px solid var(--gold);
    box-shadow: 0 10px 20px rgba(0,0,0,0.4);
}

        .testimony-card h4 {
            color: var(--gold);
            margin-bottom: 10px;
        }

        .no-testimonies {
            grid-column: 1 / -1;
            text-align: center;
            color: var(--gold);
            font-size: 1.2rem;
        }
    </style>
}

<div class="page-content">
    <header class="page-head">
        <h1>Testimonies</h1>
        <p class="tagline">Experience • Declaration • Hope • Testament</p>
        
        @* --- THE MISSING BUTTON --- *@
        <div style="text-align:center;">
            <a asp-controller="Testimonies" asp-action="Create" class="hero-cta">
                <i class="bi bi-plus-circle"></i> Share Your Story
            </a>
        </div>
        @* -------------------------- *@
    </header>

    <h2 class="section-title">Voices From Our Community</h2>

    <div class="testimony-grid">
        @if (!testimonies.Any())
        {
            <div class="no-testimonies">✨ No testimonies yet. Be the first to inspire others! ✨</div>
        }
        else
        {
            foreach (var item in testimonies)
            {
                var title = item?.Title ?? "(No title)";
                var desc = item?.Description ?? "";
                var author = string.IsNullOrWhiteSpace(item?.CreatedBy) ? "Anonymous" : item!.CreatedBy;
                var createdAt = item?.CreatedAt ?? "";
                var imgSrc = !string.IsNullOrWhiteSpace(item?.ImageBase64) ? $"data:image/jpeg;base64,{item.ImageBase64}" : Url.Content("~/images/whitelogo.png");

                <div class="testimony-card">
                    <img src="@imgSrc" alt="Image for @title" loading="lazy" />
                    <h4>@title</h4>
                    <p>@desc</p>
                    <small style="color:var(--gold)">By: @author</small>
                    @if (!string.IsNullOrWhiteSpace(createdAt))
                    {
                        <br /><small style="opacity:0.7">@createdAt</small>
                    }
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        (function(){
          const io = new IntersectionObserver((entries, obs) => {
            entries.forEach(e => {
              if (e.isIntersecting) {
                e.target.classList.add('show');
                obs.unobserve(e.target);
              }
            });
          }, { threshold: 0.1 });
          document.querySelectorAll('.testimony-card').forEach(c => io.observe(c));
        })();
    </script>
}