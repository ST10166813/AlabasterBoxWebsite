@model IEnumerable<Alabaster.Models.Testimony>
@{
    ViewBag.Title = "Testimonies";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var testimonies = (Model ?? Enumerable.Empty<Alabaster.Models.Testimony>())
                      .Where(x => x != null)
                      .OrderByDescending(t => t?.CreatedAt ?? "")
                      .ToList();
}

@section Styles {
    <style>
        :root {
            --gold: #FFD700;
            --ink: #fff;
            --muted: #cfcfd6;
            --glass-brd: rgba(255,255,255,.15);
            --shadow: 0 25px 70px rgba(0,0,0,.55);
        }

        /* Base & wallpaper */
        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Poppins','Segoe UI',sans-serif;
            color: var(--ink);
            background: transparent; /* wallpaper is handled by pseudo-element */
            overflow-x: hidden;
            position: relative;
        }

            /* wallpaper layer — use Url.Content so "~" resolves in Razor */
            body::before {
                content: "";
                position: fixed;
                inset: 0;
                z-index: -3;
                pointer-events: none;
                background-image: url('@Url.Content("~/Images/4.jpg")');
                background-position: center -10%;
                background-size: cover;
                background-repeat: no-repeat;
                background-attachment: fixed;
                /* subtle correction for brightness/contrast so text stays readable */
                filter: saturate(1.02) brightness(0.86);
                will-change: transform;
            }

            /* dim overlay so text and UI remain legible */
            body::after {
                content: "";
                position: fixed;
                inset: 0;
                z-index: -2;
                pointer-events: none;
                background: rgba(0,0,0,0.22);
            }

        /* ensure nav/header appear above wallpaper */
        header, nav, .page-content {
            position: relative;
            z-index: 5;
        }

        /* page container */
        .page-content {
            max-width: 1400px;
            margin: 3.5rem auto;
            padding: clamp(1rem, 3vw, 2.4rem);
        }

        /* heading */
        .page-head {
            text-align: center;
            margin-bottom: 1.2rem;
        }

            .page-head h1 {
                font-size: clamp(2.2rem, 4.8vw, 3.8rem);
                font-weight: 900;
                margin: 0;
                color: #fff;
                text-shadow: 0 2px 6px rgba(0,0,0,.55);
            }

            .page-head .tagline {
                color: rgba(255,255,255,.92);
            }

        /* section title */
        .section-title {
            display: inline-block;
            padding: .7rem 1.1rem;
            border-radius: 14px;
            background: linear-gradient(180deg, rgba(255,215,0,.12), rgba(255,255,255,.02));
            color: var(--gold);
            font-weight: 900;
            text-transform: uppercase;
        }

        /* testimony grid & cards */
        .testimony-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: clamp(1rem, 2vw, 1.6rem);
            margin-top: 1rem;
        }

        .testimony-card {
            background: rgba(18,18,18,.65);
            border: 1px solid var(--glass-brd);
            border-radius: 16px;
            padding: 1.4rem;
            text-align: center;
            box-shadow: var(--shadow);
            color: var(--ink);
            opacity: 0;
            transform: translateY(30px);
            transition: opacity .6s ease, transform .6s cubic-bezier(.2,.9,.25,1);
        }

            .testimony-card.show {
                opacity: 1;
                transform: translateY(0);
            }

            /* FIX: prevent cropping — keep same non-cropping rules you had before */
            .testimony-card img {
                width: 75%; /* not full width — keeps aspect and avoids squish/crop */
                max-height: 200px; /* limits height */
                object-fit: contain; /* show the whole image (no cropping) */
                border-radius: 12px;
                margin: 0 auto 0.9rem; /* center it and keep spacing */
                display: block;
            }

            .testimony-card h4 {
                color: var(--gold);
                font-weight: 800;
                margin-bottom: .4rem;
            }

            .testimony-card p {
                color: #eee;
                line-height: 1.6;
                margin-bottom: .6rem;
            }

        .no-testimonies {
            grid-column: 1 / -1;
            text-align: center;
            color: var(--gold);
        }

        /* sparkle elements (animated by JS, not keyframes) */
        .sparkle {
            position: fixed;
            width: 3px;
            height: 3px;
            background: rgba(255,215,0,0.9);
            border-radius: 50%;
            pointer-events: none;
            z-index: 1;
            opacity: 0;
            transform: translateY(0) scale(.6);
            transition: transform 900ms ease, opacity 900ms ease;
        }
    </style>
}

@section Scripts {
    <script>
        // Reveal cards when they enter viewport
        (function(){
          const io = new IntersectionObserver((entries, obs) => {
            entries.forEach(e => {
              if (e.isIntersecting) {
                e.target.classList.add('show');
                obs.unobserve(e.target);
              }
            });
          }, { threshold: 0.18 });

          document.querySelectorAll('.testimony-card').forEach(c => io.observe(c));
        })();

        // subtle sparkle via JS transitions (no keyframes)
        (function(){
          function make(){
            const s = document.createElement('div');
            s.className = 'sparkle';
            const size = Math.random()*3 + 2;
            s.style.width = s.style.height = size + 'px';
            s.style.left = Math.random()*window.innerWidth + 'px';
            s.style.top = Math.random()*window.innerHeight + 'px';
            document.body.appendChild(s);
            void s.offsetWidth;
            s.style.opacity = '1';
            s.style.transform = 'translateY(-30px) scale(1)';
            const life = 3500 + Math.random()*4000;
            setTimeout(()=> {
              s.style.opacity = '0';
              s.style.transform = 'translateY(-60px) scale(.6)';
              setTimeout(()=> s.remove(), 900);
            }, life);
          }
          setInterval(make, 900);
        })();
    </script>
}

<div class="page-content">
    <header class="page-head" aria-labelledby="t-head">
        <h1 id="t-head">Testimonies</h1>
        <div class="tagline">Experience • Declaration • Hope • Testament</div>
    </header>

    <h2 class="section-title">Voices From Our Community</h2>

    <div class="testimony-grid" role="list">
        @if (!testimonies.Any())
        {
            <div class="no-testimonies">✨ No testimonies yet. Be the first to inspire others! ✨</div>
        }
        else
        {
            foreach (var item in testimonies)
            {
                var title = item?.Title ?? "(No title)";
                var desc = item?.Description ?? "";
                var author = string.IsNullOrWhiteSpace(item?.CreatedBy) ? "Anonymous" : item!.CreatedBy;
                var createdAt = item?.CreatedAt ?? "";
                var imgSrc = !string.IsNullOrWhiteSpace(item?.ImageBase64) ? $"data:image/jpeg;base64,{item.ImageBase64}" : Url.Content("~/Images/whitelogo.png");

                <div class="testimony-card" role="listitem" aria-labelledby="t-@item?.Id">
                    <img src="@imgSrc" alt="Image for @title" loading="lazy" />
                    <h4 id="t-@item?.Id">@title</h4>
                    <p>@desc</p>
                    <small>By: @author</small>
                    @if (!string.IsNullOrWhiteSpace(createdAt))
                    {
                        <small> • @createdAt</small>
                    }
                </div>
            }
        }
    </div>
</div>
