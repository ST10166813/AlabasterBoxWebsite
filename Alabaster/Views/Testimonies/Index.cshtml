@using System
@using System.Linq
@model IEnumerable<Alabaster.Models.Testimony>

@{
    ViewBag.Title = "Testimonies";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Helper to safely obtain a DateTime from item.CreatedAt whether it's stored as a string or DateTime.
    Func<Alabaster.Models.Testimony, DateTime> getDate = (t) =>
    {
        if (t == null) return DateTime.MinValue;
        try
        {
            object val = (object)t.CreatedAt;
            if (val == null) return DateTime.MinValue;
            if (val is DateTime dt) return dt;
            var s = val as string;
            if (!string.IsNullOrWhiteSpace(s) && DateTime.TryParse(s, out var parsed)) return parsed;
        }
        catch { }
        return DateTime.MinValue;
    };

    // Normalize Model so we never operate on null and order by parsed date safely.
    var testimonies = (Model ?? Enumerable.Empty<Alabaster.Models.Testimony>())
                       .OrderByDescending(getDate)
                       .ToList();
}

@section Styles {
    <style>
        :root {
            --gold: #FFD700;
            --ink: #fff;
            --muted: #cfcfd6;
            --glass-brd: rgba(255,255,255,.15);
            --shadow: 0 25px 70px rgba(0,0,0,.55);
        }

        /* ===== Global background: use a dedicated fixed image layer so the wallpaper always shows =====
                   - html/body kept clean and transparent so the layout/background can be controlled here.
                   - body::before = wallpaper image (uses Url.Content so ~ resolves in Razor)
                   - body::after  = soft dim overlay for legibility
                */
        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Poppins','Segoe UI',sans-serif;
            color: var(--ink);
            background: transparent; /* leave actual image to pseudo-element */
            overflow-x: hidden;
            position: relative;
        }

            /* Wallpaper image layer (fixed) */
            body::before {
                content: "";
                position: fixed;
                inset: 0;
                z-index: -3;
                background-image: url('@Url.Content("~/images/cross7.png")');
                background-position: center -10%;
                background-size: cover;
                background-repeat: no-repeat;
                background-attachment: fixed;
                /* subtle adjustments for contrast */
                filter: saturate(1.02) brightness(0.86);
                will-change: transform;
            }

            /* Soft global tint so text and UI remain readable */
            body::after {
                content: "";
                position: fixed;
                inset: 0;
                z-index: -2;
                background: rgba(0,0,0,0.20);
                pointer-events: none;
            }

        /* Ensure nav/header sits above the wallpaper layers */
        header, nav, .nav-guard, .top-words, .auth-links {
            position: relative;
            z-index: 5;
        }

        /* ===== Page container ===== */
        .page-content {
            position: relative;
            z-index: 10; /* above wallpaper & overlay */
            max-width: 1400px;
            margin-inline: auto;
            padding: clamp(2.5rem, 6vw, 5rem) 1.25rem clamp(3rem, 7vw, 5rem);
            box-sizing: border-box;
        }

        /* ===== Heading ===== */
        .page-head {
            display: grid;
            gap: .6rem;
            justify-items: center;
            text-align: center;
            margin-bottom: clamp(1.6rem, 3.2vw, 2.2rem);
        }

            .page-head h1 {
                font-size: clamp(2.4rem, 5.6vw, 4.4rem);
                font-weight: 900;
                line-height: 1.05;
                letter-spacing: .3px;
                text-transform: uppercase;
                color: #fff;
                text-shadow: 0 2px 6px rgba(0,0,0,.55);
                margin: 0;
            }

            .page-head .tagline {
                font-size: clamp(.95rem, 1.6vw, 1.15rem);
                letter-spacing: .6px;
                opacity: .95;
            }

        /* short intro paragraph under the heading */
        .hero-intro {
            display: grid;
            gap: .9rem;
            justify-items: center;
            text-align: center;
            margin-bottom: clamp(1.8rem, 3vw, 2.4rem);
        }

            .hero-intro p {
                max-width: 920px;
                opacity: .92;
                font-size: clamp(1rem, 1.4vw, 1.12rem);
            }

        /* CTA */
        .hero-cta {
            display: inline-block;
            margin-top: .3rem;
            padding: .9rem 2.2rem;
            font-weight: 800;
            font-size: 1rem;
            letter-spacing: .3px;
            border-radius: 999px;
            text-decoration: none;
            background: linear-gradient(135deg,#ffb347,#ffcc33);
            color: #111;
            border: 1px solid rgba(255,215,0,.55);
            box-shadow: 0 10px 26px rgba(255,200,0,.30);
            transition: transform .2s ease, box-shadow .2s ease;
        }

            .hero-cta:hover {
                transform: translateY(-2px);
                box-shadow: 0 14px 38px rgba(255,200,0,.45);
            }

        /* Section title */
        .section-title {
            font-size: clamp(1.6rem, 2.6vw, 2.2rem);
            font-weight: 900;
            text-align: center;
            margin: 1.8rem auto 2.2rem;
            padding: 0.9rem 1.6rem;
            border-radius: 18px;
            background: linear-gradient(180deg, rgba(255,215,0,0.12), rgba(255,255,255,0.03));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        /* Testimony grid + cards */
        .testimony-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: clamp(1.2rem, 2.2vw, 2rem);
        }

        .testimony-card {
            position: relative;
            background: rgba(18,18,18,.65);
            border: 1px solid var(--glass-brd);
            border-radius: 18px;
            backdrop-filter: blur(18px) saturate(150%);
            box-shadow: var(--shadow);
            padding: 1.6rem 1.3rem 2rem;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            color: var(--ink);
            opacity: 0;
            transform: translateY(40px);
            transition: all .6s cubic-bezier(.25,.1,.25,1);
        }

            .testimony-card.show {
                opacity: 1;
                transform: translateY(0);
            }

            .testimony-card:hover {
                transform: translateY(-8px);
                border-color: rgba(255,215,0,.35);
                box-shadow: 0 18px 46px rgba(255,215,0,.35);
            }

            .testimony-card img {
                width: 75%;
                max-height: 200px;
                border-radius: 14px;
                object-fit: contain;
                margin: 0 auto 1rem;
                display: block;
                transition: transform 0.35s ease;
            }

                .testimony-card img:hover {
                    transform: scale(1.04);
                }

            .testimony-card h4 {
                font-size: 1.35rem;
                font-weight: 800;
                color: var(--gold);
                margin-bottom: .5rem;
                text-shadow: 0 0 10px rgba(255,215,0,.22);
            }

            .testimony-card p {
                font-size: .98rem;
                color: #eee;
                line-height: 1.7;
                margin-bottom: .5rem;
            }

            .testimony-card small {
                font-size: .88rem;
                color: var(--muted);
            }

        .no-testimonies {
            grid-column: 1 / -1;
            text-align: center;
            font-size: 1.1rem;
            color: var(--gold);
            margin: 1.2rem 0;
        }

        /* subtle sparkle */
        .sparkle {
            position: fixed;
            width: 3px;
            height: 3px;
            background: rgba(255,215,0,0.9);
            border-radius: 50%;
            pointer-events: none;
            z-index: 0;
            transition: transform 900ms ease, opacity 900ms ease;
            filter: blur(0.6px);
        }

        .hidden-visually {
            position: absolute !important;
            height: 1px;
            width: 1px;
            overflow: hidden;
            clip: rect(1px,1px,1px,1px);
            white-space: nowrap;
        }

        .container-pad {
            padding-inline: clamp(12px, 4vw, 36px);
        }
    </style>
}

@section Scripts {
    <script>
        // Intersection observer to reveal cards safely (no null access)
        (function(){
          const io = new IntersectionObserver((entries) => {
            entries.forEach(e => {
              if (e.isIntersecting) {
                e.target.classList.add('show');
                io.unobserve(e.target);
              }
            });
          }, { threshold: 0.18 });

          document.querySelectorAll('.testimony-card').forEach(el => io.observe(el));
        })();

        // Sparkles (safe, minimal)
        (function createSparkles(){
          function make(){
            const s = document.createElement('div');
            s.className = 'sparkle';
            const size = Math.random()*3+2;
            s.style.width = s.style.height = size + 'px';
            s.style.left = Math.random()*window.innerWidth + 'px';
            s.style.top = Math.random()*window.innerHeight + 'px';
            document.body.appendChild(s);
            // trigger transition
            void s.offsetWidth;
            s.style.opacity = '1';
            s.style.transform = 'translateY(-30px) scale(1)';
            setTimeout(()=>{ s.style.opacity='0'; s.style.transform='translateY(-60px) scale(.6)'; setTimeout(()=>s.remove(),900); }, 3000 + Math.random()*3000);
          }
          setInterval(make, 900);
        })();
    </script>
}

<div class="page-content">
    <!-- Heading -->
    <header class="page-head" aria-labelledby="t-head">
        <h1 id="t-head">Testimonies</h1>
        <div class="tagline">Experience • Declaration • Hope • Testament</div>
    </header>

    <section class="hero-intro" aria-label="Introduction">
        <p>Stories change hearts. Here are real accounts of hope, healing and transformation from our Alabaster family. Share yours to encourage someone today.</p>
        <a asp-controller="Testimonies" asp-action="Create" class="hero-cta">Share Your Story</a>
    </section>

    <h2 class="section-title">Voices From Our Community</h2>

    <div class="testimony-grid">
        @* Use normalized 'testimonies' list so Model==null won't crash view *@
        @if (!testimonies.Any())
        {
            <div class="no-testimonies">✨ No testimonies yet. Be the first to inspire others! ✨</div>
        }
        else
        {
            foreach (var item in testimonies)
            {
                // guard 'item' nullable properties safely
                var imagePresent = !string.IsNullOrEmpty(item?.ImageBase64);
                var title = item?.Title ?? "(No title)";
                var desc = item?.Description ?? "";
                var author = string.IsNullOrEmpty(item?.CreatedBy) ? "Anonymous" : item.CreatedBy;
                var dt = getDate(item);
                var dateText = dt != DateTime.MinValue ? dt.ToString("g") : "";

                <div class="@(imagePresent ? "testimony-card" : "testimony-card no-image")">
                    @if (imagePresent)
                    {
                        <img src="data:image/jpeg;base64,@item.ImageBase64" alt="Testimony image for @title" loading="lazy" />
                    }
                    else
                    {
                        <img src="@Url.Content("~/images/whitelogo.png")" alt="Default logo" loading="lazy" />
                    }

                    <h4>@title</h4>
                    <p>@desc</p>
                    <small>By: @author</small>
                    <small>Date: @dateText</small>
                </div>
            }
        }
    </div>
</div>
