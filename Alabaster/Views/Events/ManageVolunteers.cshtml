@model List<Alabaster.Models.Volunteer>

@{
    ViewData["Title"] = "Manage Volunteers";
}

@section Styles {
    <style>
        :root {
            --gold: #FFD700;
            --ink: #fff;
            --muted: #cfcfd6;
            --glass-1: rgba(51, 51, 51, 0.65);
            --glass-2: rgba(103, 103, 106, 0.45);
            --glass-brd: rgba(84, 83, 83, 0.41);
            --shadow: 0 25px 70px rgba(0,0,0,.55);
        }

        /* ==== Page background: use Url.Content so "~" resolves in Razor ==== */
        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Poppins','Segoe UI',sans-serif;
            color: var(--ink);
            background: #08090c; /* fallback */
            overflow-x: hidden;
            position: relative;
        }

            /* background image layer */
            body::before {
                content: "";
                position: fixed;
                inset: 0;
                z-index: -3;
                background-image: url('@Url.Content("~/Images/4.jpg")');
                background-position: center -10%;
                background-size: cover;
                background-repeat: no-repeat;
                background-attachment: fixed;
                filter: saturate(1.02) brightness(0.86);
            }

            /* subtle tint layer */
            body::after {
                content: "";
                position: fixed;
                inset: 0;
                z-index: -2;
                background: rgba(0,0,0,0.28); /* global dim so text is legible */
                pointer-events: none;
            }

        /* ===== Content container ===== */
        .page-content {
            position: relative;
            z-index: 1;
            max-width: 1400px;
            margin-inline: auto;
            padding: clamp(2rem, 5vw, 4rem);
            box-sizing: border-box;
        }

        /* section / card */
        .glass-panel {
            background: linear-gradient(180deg, var(--glass-1), var(--glass-2));
            border: 1px solid var(--glass-brd);
            border-radius: 20px;
            box-shadow: var(--shadow);
            padding: clamp(1rem, 2vw, 1.6rem);
            backdrop-filter: blur(10px);
            transform: translateY(18px);
            opacity: 0;
            transition: transform 620ms cubic-bezier(.16,.84,.28,1), opacity 620ms ease;
        }

            /* When the reveal JS adds .visible, the panel fades/slide in */
            .glass-panel.visible {
                transform: translateY(0);
                opacity: 1;
            }

        /* heading */
        .page-head {
            display: grid;
            gap: .6rem;
            justify-items: center;
            text-align: center;
            margin-bottom: clamp(1rem, 3vw, 2rem);
        }

            .page-head h1 {
                font-size: clamp(2.2rem, 5.2vw, 3.6rem);
                font-weight: 900;
                line-height: 1.06;
                letter-spacing: .3px;
                text-transform: uppercase;
                color: #fff;
                text-shadow: 0 2px 6px rgba(0,0,0,.55);
            }

        /* small tagline */
        .tagline {
            font-size: clamp(.92rem, 1.3vw, 1.05rem);
            letter-spacing: .5px;
            color: var(--ink);
            opacity: .95;
        }

        /* section title (text clipped gradient but no animation) */
        .section-title {
            font-size: clamp(1.2rem, 2vw, 1.8rem);
            font-weight: 900;
            text-align: center;
            margin: 1.6rem auto 1.6rem;
            padding: .55rem 1rem;
            border-radius: 14px;
            background: linear-gradient(90deg, rgba(255,215,0,0.12), rgba(255,255,255,0.02));
            color: var(--gold);
        }

        /* controls */
        .controls {
            display: flex;
            justify-content: center;
            margin-bottom: 1rem;
            gap: 12px;
        }

        /* select styling (fluid; no media queries) */
        .event-select {
            width: min(560px, 95%);
            position: relative;
        }

            .event-select select {
                width: 100%;
                box-sizing: border-box;
                background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.02));
                color: #fff;
                padding: .75rem 1rem;
                font-size: clamp(.95rem, 1.3vw, 1.05rem);
                border-radius: 10px;
                border: 1px solid rgba(255,215,0,0.45);
                cursor: pointer;
                transition: box-shadow .18s ease, border-color .18s ease, transform .08s ease;
            }

                .event-select select:focus, .event-select select:hover {
                    border-color: var(--gold);
                    box-shadow: 0 0 14px rgba(255,215,0,0.28);
                    outline: none;
                }

        /* table wrapper */
        .table-wrap {
            overflow: auto;
            border-radius: 12px;
            background: rgba(255,255,255,.02);
            border: 1px solid rgba(255,255,255,0.06);
            margin-top: .8rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 750px;
            color: var(--ink);
            font-size: clamp(.95rem, 1.1vw, 1rem);
        }

        thead th {
            font-weight: 900;
            text-transform: uppercase;
            font-size: .9rem;
            letter-spacing: .05em;
            background: linear-gradient(180deg, rgba(213, 188, 43, 0.9), rgba(169, 161, 120, 0.54));
            color: #111;
            padding: .9rem .75rem;
            position: sticky;
            top: 0;
            z-index: 1;
        }

        tbody td {
            padding: .8rem .75rem;
            vertical-align: top;
            border-bottom: 1px solid rgba(255,255,255,0.04);
        }

        /* row hover effect via transition (no keyframes) */
        tbody tr {
            transition: transform .18s ease, background .18s ease, box-shadow .18s ease;
        }

            tbody tr:hover {
                background: rgba(255,255,255,0.03);
                transform: translateY(-2px);
                box-shadow: 0 10px 28px rgba(0,0,0,0.35);
            }

        /* empty state */
        .empty-wrap {
            margin-top: 1.8rem;
            display: grid;
            gap: .8rem;
            justify-items: center;
            text-align: center;
        }

            .empty-wrap p {
                color: rgba(255,255,255,0.9);
                max-width: 820px;
                line-height: 1.6;
                font-size: clamp(.96rem, 1.05vw, 1rem);
            }

        /* subtle sparkle (created/removed by JS) */
        .sparkle {
            position: fixed;
            width: 3px;
            height: 3px;
            background: rgba(255,215,0,0.9);
            border-radius: 50%;
            pointer-events: none;
            z-index: 0;
            filter: blur(0.4px);
            opacity: 0;
            transform: translateY(0) scale(.6);
            transition: transform 900ms ease, opacity 900ms ease;
        }
        /* when JS sets size & position and triggers reflow, we tweak opacity via inline style to simulate motion */

        /* small helpers */
        .hidden-visually {
            position: absolute !important;
            height: 1px;
            width: 1px;
            overflow: hidden;
            clip: rect(1px,1px,1px,1px);
            white-space: nowrap;
        }

        /* make layout naturally responsive (no media queries) */
        .container-pad {
            padding-inline: clamp(12px, 4vw, 36px);
        }
    </style>
}

<div class="page-content container-pad">
    <header class="page-head" aria-labelledby="mv-head">
        <h1 id="mv-head">Manage Volunteers</h1>
        <div class="tagline">Admin • Volunteers • Events • Community</div>
        <p class="head-desc">View and manage volunteer sign-ups by event. Use the selector to filter and coordinate your teams with clarity.</p>
    </header>

    <h2 class="section-title">Volunteer Roster</h2>

    <div class="glass-panel" id="mainPanel">
        <div class="controls">
            <div class="event-select" aria-label="Filter by event">
                <form method="get" asp-action="ManageVolunteers">
                    <select name="eventId" onchange="this.form.submit()">
                        <option value="">-- Select Event --</option>
                        @foreach (var evt in (List<Alabaster.Models.UpcomingEvent>)ViewBag.Events)
                        {
                            @* Render option with or without selected attribute using server-side branching to avoid Razor attribute parsing errors *@
                            if (ViewBag.SelectedEventId != null && ViewBag.SelectedEventId == evt.Id)
                            {
                                <option value="@evt.Id" selected="selected">@evt.Name (@evt.Date)</option>
                            }
                            else
                            {
                                <option value="@evt.Id">@evt.Name (@evt.Date)</option>
                            }
                        }
                    </select>
                </form>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-wrap" role="region" aria-label="Volunteer table">
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Volunteers</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var vol in Model)
                        {
                            <tr>
                                <td>@vol.Name</td>
                                <td>@vol.Email</td>
                                <td>@vol.Phone</td>
                                <td>@vol.NumberOfVolunteers</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (ViewBag.SelectedEventId != null)
        {
            <div class="empty-wrap" aria-live="polite">
                <h3 class="section-title">No Volunteers Yet</h3>
                <p>No volunteers are registered for this event yet. Share the sign-up link and check back soon.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Reveal the main panel (uses transitions instead of keyframes)
        (function(){
          const panel = document.getElementById('mainPanel');
          if (!panel) return;
          // use IntersectionObserver for nicer reveal when in viewport
          const observer = new IntersectionObserver(entries => {
            entries.forEach(e => {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                observer.unobserve(e.target);
              }
            });
          }, { threshold: 0.12 });
          observer.observe(panel);
        })();

        // Subtle sparkles (create and remove). We animate via inline styles and CSS transitions (no keyframes).
        (function () {
          function createSparkle() {
            const s = document.createElement('div');
            s.className = 'sparkle';
            const size = Math.random() * 3 + 2;
            s.style.width = s.style.height = size + 'px';
            s.style.left = Math.random() * window.innerWidth + 'px';
            s.style.top = Math.random() * window.innerHeight + 'px';
            // set a small random transform to simulate motion, then fade out
            document.body.appendChild(s);
            // force a reflow so transition applies
            void s.offsetWidth;
            s.style.opacity = '1';
            s.style.transform = 'translateY(-30px) scale(1)';
            // remove after duration
            const lifetime = 3500 + Math.random() * 3500;
            setTimeout(() => {
              s.style.opacity = '0';
              s.style.transform = 'translateY(-60px) scale(.6)';
              setTimeout(() => s.remove(), 900);
            }, lifetime);
          }
          // lower cadence so page isn't noisy
          setInterval(createSparkle, 800);
        })();
    </script>
}
