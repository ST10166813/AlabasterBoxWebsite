@model List<Alabaster.Models.Volunteer>

@{
    ViewData["Title"] = "Manage Volunteers";
}

@section Styles {
    @await Html.PartialAsync("_EventsShared")

    <style>
        /* ManageVolunteers-specific tweaks (kept local) */
        .page-content {
            padding: clamp(2.5rem, 6vw, 5rem) 1.25rem clamp(3rem, 7vw, 5rem);
        }

        .page-head h1 {
            font-size: clamp(2.4rem, 5.6vw, 4.4rem);
            font-weight: 900;
            text-transform: uppercase;
            color: #fff;
            text-shadow: 0 2px 6px rgba(0,0,0,.55);
        }

        .tagline {
            font-size: clamp(.95rem, 1.6vw, 1.15rem);
            letter-spacing: .6px;
            color: var(--ink);
            opacity: .95;
            display: inline-flex;
            gap: .7rem;
            flex-wrap: wrap;
        }

        .event-select {
            position: relative;
            width: 360px;
            max-width: 100%;
        }

            .event-select::after {
                content: "▾";
                position: absolute;
                right: 14px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--gold);
                pointer-events: none;
                font-size: 1.1rem;
                opacity: .8;
            }

        .controls {
            display: flex;
            justify-content: center;
            margin-bottom: 1.25rem;
        }
    </style>
}

<div class="page-content">
    <header class="page-head" aria-labelledby="mv-head">
        <h1 id="mv-head">MANAGE VOLUNTEERS</h1>
        <div class="tagline">Admin • Volunteers • Events • Community</div>
        <p class="head-desc">View and manage volunteer sign-ups by event. Use the selector to filter the roster and coordinate your teams with clarity.</p>
    </header>

    <h2 class="section-title">Volunteer Roster</h2>

    <div class="glass-panel">
        <div class="controls">
            <div class="event-select">
                <form method="get" asp-action="ManageVolunteers">
                    <select name="eventId" onchange="this.form.submit()">
                        <option value="">-- Select Event --</option>
                        @foreach (var evt in (List<Alabaster.Models.UpcomingEvent>)ViewBag.Events)
                        {
                            <option value="@evt.Id" selected="@(ViewBag.SelectedEventId == evt.Id ? "selected" : null)">@evt.Name (@evt.Date)</option>
                        }
                    </select>
                </form>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr><th>Name</th><th>Email</th><th>Phone</th><th>Volunteers</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var vol in Model)
                        {
                            <tr>
                                <td>@vol.Name</td>
                                <td>@vol.Email</td>
                                <td>@vol.Phone</td>
                                <td>@vol.NumberOfVolunteers</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (ViewBag.SelectedEventId != null)
        {
            <div class="empty-wrap" aria-live="polite">
                <h3 class="section-title">No Volunteers Yet</h3>
                <p>No volunteers are registered for this event yet. Share the sign-up link and check back soon.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // ManageVolunteers doesn't need page-specific JS — shared partial handles sparkles and file wiring.
    </script>
}
