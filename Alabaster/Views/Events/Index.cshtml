@model List<Alabaster.Models.UpcomingEvent>

@{
    ViewData["Title"] = "Upcoming Events";
}

<style>
:root{
  --nav-height: 130px;                /* adjust if your navbar height differs */
  --glass-start: rgba(16,16,20,.55);
  --glass-end:   rgba(16,16,20,.38);
  --glass-border: rgba(255,255,255,0.35);
  --glass-shadow: 0 24px 60px rgba(0,0,0,.45);
  --gold: #FFD700;
}

/* Base */
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  font-family: 'Poppins','Segoe UI',system-ui,-apple-system,sans-serif;
  background: #08090c url('../images/cross7.png') center -10% / cover no-repeat fixed;
  color: #fff; min-height: 100vh; overflow-x: hidden;
  scroll-padding-top: calc(var(--nav-height) + 16px); /* smooth anchor offsets */
}
a { color: inherit; text-decoration: none; }
img { max-width: 100%; display: block; }

/* Wrapper (adds top spacing so nothing hides under fixed navbar) */
.about-wrap {
  position: relative; z-index: 1;
  display: grid; gap: clamp(2rem, 4vw, 3rem);
  padding: calc(var(--nav-height) + 24px) 1.25rem clamp(4rem, 7vw, 6rem);
  max-width: 1400px; margin-inline: auto;
}

/* Heading */
.page-head { display: grid; gap:.6rem; justify-items:center; text-align:center; }
.page-head h1{
  font-size: clamp(2.4rem, 5.6vw, 4.4rem);
  font-weight: 900; line-height: 1.05; letter-spacing: .3px;
  text-transform: uppercase; color:#fff;
  text-shadow: 0 2px 6px rgba(0,0,0,.55);
}
.page-head .tagline{ font-size: clamp(1rem,1.6vw,1.2rem); opacity:.95; }

/* Intro */
.hero{ display:grid; gap:.9rem; justify-items:center; text-align:center; }
.hero p{ max-width:920px; opacity:.92; font-size:clamp(1rem,1.4vw,1.15rem); }

/* Panel */
.panel{
  border-radius: 22px; border: 1px solid var(--glass-border);
  background: linear-gradient(180deg, var(--glass-start), var(--glass-end));
  backdrop-filter: blur(14px) saturate(150%); -webkit-backdrop-filter: blur(14px) saturate(150%);
  box-shadow: var(--glass-shadow);
}

/* Admin toolbar */
.admin-toolbar{ display:flex; justify-content:center; gap:.75rem; }
.btn-admin{
  display:inline-flex; align-items:center; gap:.5rem; text-transform:uppercase;
  border-radius:999px; padding:10px 16px; font-weight:800; font-size:.95rem; letter-spacing:.3px;
  background: linear-gradient(135deg,#ffb347,#ffcc33); color:#111; border:1px solid rgba(255,255,255,.18);
  box-shadow:0 10px 26px rgba(255,200,0,.30);
}

/* Grid */
.events-grid{
  display:grid; gap:clamp(1rem,2vw,1.4rem);
  grid-template-columns: repeat(3,minmax(0,1fr));
  align-items: stretch;
}
@@media (max-width:1100px){ .events-grid{ grid-template-columns:repeat(2,1fr);} }
@@media (max-width:620px){ .events-grid{ grid-template-columns:1fr;} }

/* Card (equal height) */
.event-card{
  overflow:hidden; display:flex; flex-direction:column; height:100%;
  transform: translateY(18px); opacity: 0;
  transition: transform .6s ease, opacity .6s ease, box-shadow .3s ease;
}
.event-card.visible{ transform:translateY(0); opacity:1; }
.event-card:hover{ transform: translateY(-6px) scale(1.01); box-shadow: 0 28px 70px rgba(0,0,0,.55); }

/* Image */
.image-wrapper{ position:relative; width:100%; padding-top:60%; overflow:hidden; }
.image-wrapper img{
  position:absolute; inset:0; width:100%; height:100%; object-fit:cover;
  filter: brightness(.98) contrast(1.06);
  transition: transform .45s ease, filter .45s ease;
}
.event-card:hover img{ transform: scale(1.06); filter: brightness(1.03); }

/* Expand button */
.expand-btn{
  position:absolute; right:10px; bottom:10px;
  display:inline-flex; align-items:center; justify-content:center;
  width:40px; height:40px; border-radius:10px; border:1px solid rgba(255,255,255,.35);
  background: rgba(0,0,0,.45); backdrop-filter: blur(6px); cursor:pointer;
}
.expand-btn svg{ width:22px; height:22px; fill:#fff; }

/* Body (CTA pinned bottom) */
.card-body{
  padding: clamp(16px,2vw,22px); display:grid; gap:10px;
  grid-template-rows: auto auto 1fr auto auto; text-align:center; flex:1;
}
.card-title{
  font-size:1.55rem; font-weight:900; margin:2px 0 6px;
  color:var(--gold); text-shadow:0 0 10px rgba(255,215,0,.35);
  text-transform:uppercase;
}
.meta{ display:flex; flex-wrap:wrap; gap:8px; justify-content:center; margin-top:-2px; }
.badge-chip{
  font-weight:700; font-size:.92rem; letter-spacing:.3px;
  padding:6px 10px; border-radius:999px; border:1px solid rgba(255,255,255,.18);
  background: linear-gradient(180deg, rgba(255,255,255,.10), rgba(255,255,255,.04));
}
.card-text{ font-size:1.05rem; color:#f1f1f1; line-height:1.7; }
.card-text strong{ color:var(--gold); }

/* CTA */
.btn-volunteer{
  display:inline-block; width:100%; text-align:center; margin-top:8px;
  border-radius:999px; padding:12px 0; font-weight:900; font-size:1.03rem; text-transform:uppercase;
  background: linear-gradient(135deg,#ffb347,#ffcc33); color:#111; border:none;
  box-shadow:0 10px 26px rgba(255,200,0,.30);
}

/* Lightbox (offset below fixed navbar + high z-index) */
.lightbox-backdrop{
  position:fixed; inset:0; background:rgba(0,0,0,.7);
  display:none; align-items:center; justify-content:center; z-index:10000;
}
.lightbox-backdrop[aria-hidden="false"]{ display:flex; }
.lightbox-dialog{
  max-width:min(92vw,1100px); max-height: calc(90vh - var(--nav-height));
  margin-top: var(--nav-height); /* keeps image below the navbar */
  background:#111; border-radius:16px; overflow:hidden;
  border:1px solid rgba(255,255,255,.15); box-shadow:0 40px 90px rgba(0,0,0,.6);
  position:relative;
}
.lightbox-img{ display:block; width:100%; height:auto; max-height:calc(90vh - var(--nav-height)); object-fit:contain; }
.lightbox-close{
  position:absolute; top:10px; right:10px; border:none; background:rgba(0,0,0,.55);
  color:#fff; width:40px; height:40px; border-radius:10px; cursor:pointer;
  border:1px solid rgba(255,255,255,.25);
}
</style>

@section Scripts {
<script>
/* Reveal on enter (keep lightweight animation) */
const io = new IntersectionObserver((entries, obs) => {
  entries.forEach(e => { if (e.isIntersecting){ e.target.classList.add('visible'); obs.unobserve(e.target); } });
},{ threshold:.2 });

/* Lightbox */
function openLightbox(src, alt){
  const b = document.getElementById('lightbox');
  const img = document.getElementById('lightbox-img');
  img.src = src; img.alt = alt || '';
  b.setAttribute('aria-hidden','false');
  document.getElementById('lightbox-close').focus();
}
function closeLightbox(){ document.getElementById('lightbox').setAttribute('aria-hidden','true'); }

window.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.event-card').forEach(c => io.observe(c));

  document.body.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-expand-src]'); if (!btn) return;
    openLightbox(btn.getAttribute('data-expand-src'), btn.getAttribute('data-expand-alt') || '');
  });
  document.getElementById('lightbox-close').addEventListener('click', closeLightbox);
  document.getElementById('lightbox').addEventListener('click', (e) => { if (e.target.id === 'lightbox') closeLightbox(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });
});
</script>
}

<!-- Lightbox -->
<div id="lightbox" class="lightbox-backdrop" hidden>
  <div class="lightbox-dialog" role="dialog" aria-modal="true" aria-labelledby="lightbox-title" tabindex="-1">
    <h2 id="lightbox-title" class="sr-only">Expanded image viewer</h2>
    <button id="lightbox-close" class="lightbox-close" type="button" aria-label="Close image">✕</button>
    <img id="lightbox-img" class="lightbox-img" src="" alt="Expanded image">
  </div>
</div>

<div class="about-wrap">
  <header class="page-head" aria-labelledby="upcoming-events-heading">
    <h1 id="upcoming-events-heading">Upcoming Events</h1>
    <div class="tagline">Hardwork • Timeless • Support • Drive</div>
  </header>

  @if (Context.Session.GetString("IsAdmin") == "true")
  {
    <div class="admin-toolbar" role="region" aria-label="Admin actions">
      <a href="@Url.Action("AddEvent", "Events")" class="btn-admin">Add Event</a>
    </div>
  }

  <section class="hero" aria-label="Introduction">
    <p>We are a Christ-centred community devoted to spreading hope, healing, and purpose. Through worship nights, outreaches, prayer gatherings, and community service, we create spaces where people can encounter God and experience transformation.</p>
  </section>

  @if (Model != null && Model.Any())
  {
    <section aria-label="Upcoming events" class="events-grid">
      @foreach (var evt in Model)
      {
        <article class="panel event-card">
          @if (!string.IsNullOrEmpty(evt.ImageUrl))
          {
            <div class="image-wrapper">
              <img src="@evt.ImageUrl" alt="@evt.Name" />
              <button class="expand-btn" type="button"
                      aria-label="Expand image for @evt.Name" title="Expand image"
                      data-expand-src="@evt.ImageUrl" data-expand-alt="@evt.Name">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M14 3h7v7h-2V6.41l-5.29 5.3-1.42-1.42 5.3-5.29H14V3zM10 21H3v-7h2v3.59l5.29-5.3 1.42 1.42-5.3 5.29H10V21z"/>
                </svg>
              </button>
            </div>
          }
          <div class="card-body">
            <h3 class="card-title">@evt.Name</h3>

            <div class="meta">
              <span class="badge-chip">
                @(DateTime.TryParse(evt.Date, out var dt) ? dt.ToString("MMMM dd, yyyy") : evt.Date)
              </span>
              @if (!string.IsNullOrWhiteSpace(evt.Time)) { <span class="badge-chip">@evt.Time</span> }
            </div>

            @if (!string.IsNullOrWhiteSpace(evt.Description))
            { <p class="card-text">@evt.Description</p> }
            else
            { <p class="card-text" style="opacity:.7">Details to be announced.</p> }

            <a href="@(Context.Session.GetString("UserId") != null
                      ? Url.Action("Volunteer", "Events", new { eventId = evt.Id })
                      : Url.Action("Login", "Auth"))"
               class="btn-volunteer">Volunteer</a>

            @if (Context.Session.GetString("IsAdmin") == "true")
            {
              <form asp-action="DeleteEvent" method="post" style="display:inline; margin-top:8px;">
                <input type="hidden" name="eventId" value="@evt.Id" />
                <button type="submit" class="btn btn-danger btn-sm"
                        onclick="return confirm('Are you sure you want to delete this event?');">🗑 Delete</button>
              </form>
            }
          </div>
        </article>
      }
    </section>
  }
  else
  {
    <section class="panel" style="padding:18px; text-align:center;">No upcoming events available at the moment.</section>
  }
</div>
