@model Alabaster.Models.Volunteer

@{
    ViewData["Title"] = "Volunteer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"/>

@section Styles {
<style>
:root{
  --bg:#08090c;
  --ink:#f2f2f2;
  --muted:#cfcfd6;
  --gold:#FFD700;
  --gold-ink:#181818;
  --shadow:0 24px 60px rgba(0,0,0,.55);
}

/* ===== Base ===== */
html, body{
  margin:0;
  font-family:'Poppins','Segoe UI',system-ui,-apple-system,sans-serif;
  color:var(--ink);
  background: var(--bg) url('../Images/4.jpg') center -10% / cover no-repeat fixed;
  min-height:100vh;
  overflow-x:hidden;
}

/* ===== Hero Section ===== */
.hero-title{
  text-align:center;
  padding: clamp(90px, 11vh, 130px) 20px 40px;
}
.hero-title h1{
  font-size: clamp(2.4rem, 4vw, 3.6rem);
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:2px;
  color:#fff;
  text-shadow:0 2px 6px rgba(0,0,0,.55);
}
.hero-title .tagline{
  font-size:1.1rem; color:#fff; opacity:.9; margin-top:6px;
}
.hero-title p{
  font-size:1.05rem; color:#fff; opacity:.9; max-width:760px;
  margin:12px auto 0;
}

/* ===== Form Card ===== */
.volunteer-card{
  width:min(1280px,94vw);
  margin:0 auto;
  padding:clamp(18px,2vw,28px);
  border-radius:22px;
  border:1px solid rgba(255,255,255,.18);
  background: linear-gradient(180deg, rgba(18,18,22,.55), rgba(18,18,22,.35));
  backdrop-filter:blur(14px) saturate(140%);
  box-shadow:var(--shadow);
}
h2.page-title{
  text-align:center;
  font-size:clamp(1.6rem,2.2vw,2.1rem);
  font-weight:900;
  background:linear-gradient(90deg,var(--gold),#fff 45%,#c6c6c6);
  -webkit-background-clip:text; color:transparent;
  text-shadow:0 0 18px rgba(255,255,255,.18);
}
.subtitle{
  text-align:center; margin-top:4px; color:#dcdce5; opacity:.9; font-size:.98rem;
}
.hr{
  height:1px; margin:18px 0;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.18),transparent);
  border:0;
}

/* ===== Form Layout ===== */
.form-grid{
  display:grid; gap:14px; grid-template-columns:1fr;
}
@@media (min-width:860px){
  .form-grid{ grid-template-columns:1fr 1fr; }
  .col-span-2{ grid-column:1 / -1; }
}
label{ font-weight:700; font-size:.95rem; color:#efefef; }

/* ===== Input Fields ===== */
.input-wrap{
  display:flex; align-items:center; gap:10px;
  border:1px solid rgba(255,255,255,.14);
  background:rgba(255,255,255,.02);
  border-radius:14px; padding:10px 12px;
  transition:border-color .2s, box-shadow .2s;
}
.input-wrap:hover{ border-color:rgba(255,215,0,.35); }
.input-wrap:focus-within{
  border-color:rgba(255,215,0,.85);
  box-shadow:0 0 0 2px rgba(255,215,0,.45),0 0 14px rgba(255,215,0,.25);
  background:rgba(255,255,255,.03);
}
.input-icon{ font-size:1.05rem; opacity:.9; }

/* Transparent field styling */
.form-control{
  flex:1; border:0; outline:none !important;
  background:transparent !important;
  color:#fff !important;
  font-size:.98rem; padding:8px 4px;
  caret-color:var(--gold);
  box-shadow:none !important;
}

/* Placeholder text */
::placeholder{ color:#fff !important; opacity:.85; }

/* Remove native focus ring (Chrome, Edge, Firefox, Safari) */
input:focus, textarea:focus, select:focus {
  outline:none !important;
  box-shadow:none !important;
  border:none;
}

/* Dropdown */
select.form-control{
  appearance:none; -webkit-appearance:none; -moz-appearance:none;
  background:transparent !important; color:#fff !important;
}
select.form-control option{ background:#111; color:#fff; }

/* Textarea */
textarea.form-control{ resize:vertical; min-height:110px; }

/* ===== Autofill Fix (Chrome, Edge, Firefox) ===== */
input:-webkit-autofill,
textarea:-webkit-autofill,
select:-webkit-autofill {
  -webkit-text-fill-color:#fff !important;
  caret-color:var(--gold);
  transition:background-color 9999s ease-in-out 0s;
  box-shadow:0 0 0px 1000px rgba(255,255,255,.02) inset !important;
}
input:-webkit-autofill:focus,
textarea:-webkit-autofill:focus,
select:-webkit-autofill:focus {
  box-shadow:0 0 0px 1000px rgba(255,255,255,.03) inset !important;
}
input:-moz-autofill,
textarea:-moz-autofill,
select:-moz-autofill {
  box-shadow:0 0 0px 1000px rgba(255,255,255,.02) inset !important;
  -moz-text-fill-color:#fff !important;
}
.input-wrap:has(input:-webkit-autofill),
.input-wrap:has(textarea:-webkit-autofill),
.input-wrap:has(select:-webkit-autofill) {
  border-color:rgba(255,215,0,.55);
  box-shadow:0 0 0 2px rgba(255,215,0,.35),0 0 14px rgba(255,215,0,.20);
}

/* ===== Validation & Alerts ===== */
.text-danger{ color:#ffc6c6; font-size:.85rem; }
.alert-success{
  background:rgba(46,204,113,.15);
  border:1px solid rgba(46,204,113,.3);
  color:#e9ffe9; padding:10px 12px; border-radius:10px; margin-bottom:12px;
}
.alert-summary{
  background:rgba(255,77,77,.12);
  border:1px solid rgba(255,77,77,.28);
  color:#ffe2e2; padding:10px 12px; border-radius:10px; margin-bottom:10px;
}

/* ===== Buttons ===== */
.actions{ margin-top:14px; display:grid; gap:12px; }
.btn-primary{
  display:inline-flex; align-items:center; justify-content:center; gap:10px;
  background:linear-gradient(135deg,var(--gold),#FFB700);
  color:var(--gold-ink);
  border:1px solid rgba(255,215,0,.5);
  border-radius:12px;
  font-weight:900; font-size:.98rem;
  padding:12px 16px; width:100%;
  box-shadow:0 10px 26px rgba(255,215,0,.28);
  transition:transform .18s, box-shadow .18s;
}
.btn-primary:hover{
  transform:translateY(-1px);
  box-shadow:0 16px 38px rgba(255,215,0,.38);
}
.btn-alt{
  display:inline-flex; align-items:center; justify-content:center; gap:12px;
  background:rgba(255,255,255,.06);
  color:#fff; border:1px solid rgba(255,255,255,.18);
  border-radius:12px; font-weight:800; font-size:.96rem;
  padding:12px 16px; width:100%;
  box-shadow:0 10px 24px rgba(0,0,0,.28);
}
.btn-alt:hover{
  transform:translateY(-1px);
  box-shadow:0 16px 36px rgba(0,0,0,.38);
}
.hr-bottom{
  height:1px;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.18),transparent);
  margin:8px 0;
}
</style>
}

<!-- ===== HERO ===== -->
<section class="hero-title">
  <h1>Volunteer With Us</h1>
  <div class="tagline">Serve • Support • Shine • Showcase</div>
  <p>Use your gifts to serve our community. Choose an event and tell us how you’d like to help — we’ll be in touch with the details.</p>
</section>

<!-- ===== VOLUNTEER FORM ===== -->
<div class="page-overlay">
  <div class="volunteer-card">
    <h2 class="page-title">Be Part of the Mission</h2>
    <p class="subtitle">Lend a hand at an upcoming event — quick sign-up below.</p>
    <hr class="hr" />

    @if (TempData["Message"] != null)
    {
      <div class="alert-success">@TempData["Message"]</div>
    }

    <form asp-action="Volunteer" method="post" novalidate>
      <div asp-validation-summary="ModelOnly" class="alert-summary"></div>

      <div class="form-grid">
        <!-- Event -->
        <div class="col-span-2">
          <label>Select Event</label>
          <div class="input-wrap">
            <i class="bi bi-calendar-event input-icon"></i>
            <select asp-for="EventId" class="form-control">
              <option value="">-- Select Event --</option>
              @foreach (var evt in (List<Alabaster.Models.UpcomingEvent>)ViewBag.Events)
              {
                <option value="@evt.Id" selected="@(Model.EventId == evt.Id)">
                  @evt.Name (@evt.Date)
                </option>
              }
            </select>
          </div>
          <span asp-validation-for="EventId" class="text-danger"></span>
        </div>

        <!-- Name -->
        <div>
          <label>Name</label>
          <div class="input-wrap">
            <i class="bi bi-person input-icon"></i>
            <input asp-for="Name" class="form-control" placeholder="Your full name" />
          </div>
          <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <!-- Email -->
        <div>
          <label>Email</label>
          <div class="input-wrap">
            <i class="bi bi-envelope input-icon"></i>
            <input asp-for="Email" type="email" class="form-control" placeholder="you@example.com" />
          </div>
          <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <!-- Phone -->
        <div>
          <label>Phone</label>
          <div class="input-wrap">
            <i class="bi bi-telephone input-icon"></i>
            <input asp-for="Phone" class="form-control" maxlength="10" pattern="\d{10}" placeholder="10-digit number" />
          </div>
          <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <!-- Volunteers -->
        <div>
          <label>Number of Volunteers</label>
          <div class="input-wrap">
            <i class="bi bi-people input-icon"></i>
            <input asp-for="NumberOfVolunteers" type="number" class="form-control" min="1" value="1" />
          </div>
          <span asp-validation-for="NumberOfVolunteers" class="text-danger"></span>
        </div>

        <!-- Notes -->
        <div class="col-span-2">
          <label>Notes / Allergies (Optional)</label>
          <div class="input-wrap">
            <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Allergies, preferred role, time availability, etc."></textarea>
          </div>
          <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
      </div>

      <div class="actions">
        <button type="submit" class="btn-primary">
          <i class="bi bi-send-fill"></i> Submit
        </button>
        <div class="hr-bottom"></div>
        <a class="btn-alt" href="@Url.Action("Index","Events")">
          <i class="bi bi-calendar2-heart"></i> Browse Upcoming Events
        </a>
      </div>
    </form>
  </div>
</div>

