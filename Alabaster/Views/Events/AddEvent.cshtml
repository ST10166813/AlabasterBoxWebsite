@model Alabaster.Models.UpcomingEvent

@{
    ViewData["Title"] = "Add Event";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

@section Styles {
    @await Html.PartialAsync("_EventsShared")

    <style>
        /* AddEvent-specific tweaks */
        .event-card {
            width: min(1280px, 94vw);
            margin: 0 auto;
            padding: clamp(18px, 2.2vw, 28px);
            border-radius: 22px;
            border: 1px solid var(--glass-brd);
            background: linear-gradient(180deg, var(--glass-1), var(--glass-2));
            backdrop-filter: blur(14px) saturate(140%);
            -webkit-backdrop-filter: blur(14px) saturate(140%);
            box-shadow: var(--shadow);
        }

        h2.page-title {
            margin: 0;
            text-align: center;
            font-size: clamp(1.6rem, 2.2vw, 2.1rem);
            font-weight: 900;
            background: linear-gradient(90deg, var(--gold), #ffffff 45%, #c6c6c6);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-shadow: 0 0 18px rgba(255,255,255,.18);
        }

        .subtitle {
            text-align: center;
            margin-top: 4px;
            color: #dcdce5;
            opacity: .9;
            font-size: .98rem;
        }

        .hr {
            height: 1px;
            margin: 12px 0 10px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.18), transparent);
            border: 0;
        }
        /* keep small responsive tweaks locally if needed */
    </style>
}

<!-- Hero Title -->
<section class="hero-title">
    <h1>Create a New Event</h1>
    <p>Plan and share upcoming gatherings, services, or community events that bring people together.</p>
</section>

<!-- Event Form -->
<div class="page-wrap">
    <div class="event-card">
        <h2 class="page-title">Add Event Details</h2>
        <p class="subtitle">Provide a name, short description, and event poster below.</p>

        <hr class="hr" />

        <form asp-action="AddEvent" method="post" enctype="multipart/form-data" novalidate>
            <div class="form-grid">
                <div class="col-span-2">
                    <label>Event Name</label>
                    <div class="input-wrap">
                        <i class="bi bi-type input-icon"></i>
                        <input asp-for="Name" class="form-control" required placeholder="e.g., Youth Worship Night" />
                    </div>
                </div>

                <div class="col-span-2">
                    <label>Description</label>
                    <div class="input-wrap">
                        <i class="bi bi-card-text input-icon"></i>
                        <textarea asp-for="Description" class="form-control" required placeholder="Brief details about the event..."></textarea>
                    </div>
                </div>

                <div>
                    <label>Date</label>
                    <div class="input-wrap">
                        <i class="bi bi-calendar-event input-icon"></i>
                        <input asp-for="Date" type="date" class="form-control" required />
                    </div>
                </div>

                <div>
                    <label>Time</label>
                    <div class="input-wrap">
                        <i class="bi bi-clock input-icon"></i>
                        <input asp-for="Time" type="time" class="form-control" required />
                    </div>
                </div>

                <div class="col-span-2">
                    <label>Event Poster</label>

                    <!-- IMPORTANT: keep the hidden input and preview INSIDE .file-wrap so the shared JS can find them -->
                    <div class="input-wrap file-wrap">
                        <i class="bi bi-image input-icon"></i>

                        <!-- Invisible native input covering the whole wrap -->
                        <input type="file" id="eventImageFile" class="file-native" accept="image/*" />

                        <!-- Visible custom controls -->
                        <button type="button" class="file-btn"><i></i> Choose File</button>
                        <span id="fileName" class="file-name">No file chosen</span>

                        <!-- Hidden URL for base64 (now INSIDE file-wrap) -->
                        <input type="hidden" asp-for="ImageUrl" id="eventImageUrl" />

                        <!-- Optional preview (now INSIDE file-wrap) -->
                        <img id="posterPreview" class="file-preview" alt="Poster preview" />
                    </div>
                </div>
            </div>

            <div class="actions">
                <button type="submit" class="btn-primary"><i></i> Save Event</button>
                <div class="hr-bottom"></div>
                <a class="btn-alt" href="@Url.Action("Index", "Events")"><i class="bi bi-calendar2-week"></i> View All Events</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Defensive: page-level fallback wiring in case the shared script isn't present.
        // This won't hurt if the shared wiring is active; it simply ensures the hidden field
        // is set and preview shown even if the page was loaded before the shared script initialized.

        (function () {
          const fileInput = document.getElementById("eventImageFile");
          const fileNameEl = document.getElementById("fileName");
          const hiddenUrl = document.getElementById("eventImageUrl");
          const previewImg = document.getElementById("posterPreview");

          if (!fileInput) return;

          fileInput.addEventListener("change", (e) => {
            const file = e.target.files?.[0];
            if (!file) {
              if (fileNameEl) fileNameEl.textContent = "No file chosen";
              if (hiddenUrl) hiddenUrl.value = "";
              if (previewImg){ previewImg.style.display = "none"; previewImg.src = ""; }
              return;
            }

            if (fileNameEl) fileNameEl.textContent = file.name;

            const reader = new FileReader();
            reader.onloadend = () => {
              if (hiddenUrl) hiddenUrl.value = reader.result;
              if (previewImg){
                previewImg.src = reader.result;
                previewImg.style.display = "block";
              }
            };
            reader.readAsDataURL(file);
          });

          // allow clicking the visible button to open native file dialog
          document.querySelectorAll('.file-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              if (fileInput) fileInput.click();
            });
          });
        })();
    </script>
}
